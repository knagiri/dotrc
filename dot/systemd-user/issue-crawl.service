# One daily pass of bin/issue-crawl: expire stale observation issues, cluster
# the unparented ones into groups, and delegate a group once it has enough
# observations (see docs/design/agent-issue-workflow.md). Paired with
# issue-crawl.timer.
#
# `deploy.sh` symlinks dot/systemd-user/* into ~/.config/systemd/user, so this
# file is not templated at deploy time and the repo path below is written out in
# full.
# It follows the ghq layout every other absolute path in this setup uses
# (~/.bashrc has the same one). Move the checkout and this unit needs editing.
#
# PATH is set explicitly because a systemd user unit inherits none of the
# shell's: ~/.bashrc returns early for non-interactive shells, so the
# dotrc bin directory it appends is never on the PATH here. The pass needs
# `claude`, `gh`, `git`, `jq`, `mise` (the token path of bin/lib/gh-mise.sh),
# `claude-queue` and the dotrc wrappers on it.
#
# KillMode is left at its default (control-group), which kills whatever the
# service started when it exits. The crawler never starts a claude daemon
# itself: it delegates only when `claude-queue daemon-running` says one is
# already up, and its `claude -p` call was measured not to start one (in an
# empty config dir `claude -p` added no `claude daemon run` process, while
# `claude --bg` in the same dir did).
#
# Requires `loginctl enable-linger <user>` to run while logged out.

[Unit]
Description=issue-crawl: expire, cluster and delegate agent observation issues

[Service]
Type=oneshot
Environment=PATH=%h/ghq/github.com/knagiri/dotrc/bin:%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/nice -n 10 %h/ghq/github.com/knagiri/dotrc/bin/issue-crawl
# The clustering step is an LLM call that can run for minutes. The limit exists
# to cut off a stuck `claude -p` so one pass cannot pile up behind the next tick.
TimeoutStartSec=30min
