#!/usr/bin/env sh

alias g='git'

alias ls='eza --color=auto'
alias la='ls -la'
alias lah='ls -lah'
alias tree='ls -T --git-ignore'

alias rm='rm -i'

alias vim='nvim'

# ghq-tmux-session: pick a ghq repo and create/switch a tmux session.
# Repos only -- worktrees live at <repo>/.worktrees/<name>, which ghq does not
# list; reach a worktree's session with C-q q (claude-queue picker) or
# `claude attach <short-id>` instead.
alias gts='ghq-tmux-session'

alias pacman='sudo pacman'
