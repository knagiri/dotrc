#!/usr/bin/env bash
set -euo pipefail

# claude-worktree -- create a git worktree and (optionally) start a claude
# session living in that worktree.
#
# Worktree path is <main-repo-toplevel>/.worktrees/<name>, a hidden subdirectory
# of the main checkout (globally gitignored via ~/.config/git/ignore). Living
# inside the checkout keeps worktrees out of `ghq list` -- so `gts` only offers
# repositories -- and lets mise walk up into the checkout's own already-trusted
# config instead of needing one seeded per worktree. It anchors to the MAIN
# repository toplevel so the layout stays flat even when invoked from inside
# another worktree.
#
# When a prompt is given, the default is a BACKGROUND agent (`claude --bg`,
# permission mode `auto`) started with the worktree as its cwd. Reach it with
# `claude attach <short-id>` (the id is printed at launch).
#
# The two modes deliberately run different permission modes: background is
# `auto`, --tmux is `acceptEdits`. A background delegation is fire-and-forget
# with nobody watching, so under acceptEdits every command outside the allowlist
# (compound commands with variable expansion or loops, `git -c`, a tool's
# unfamiliar subcommand) raised a prompt no one could approve and the session sat
# frozen -- observed 10+ times. In `auto` mode a classifier vets those instead,
# so the delegate keeps moving without the allowlist having to grow a hole per
# incident. Existing allow/deny rules still win: the classifier only judges what
# no rule matched, and it blocks work that widens permissions beyond the request,
# targets unfamiliar infrastructure, or is driven by adversarial content; three
# consecutive (or twenty total) blocks drop the session back to normal prompts.
# That escalation is not a fix -- it reintroduces the frozen-prompt problem
# `auto` mode exists to avoid: once escalated, an unattended delegate again
# needs a human to run `claude attach <short-id>` and answer the prompt before
# it can continue. Escalation only lowers how often that happens, and exactly
# how a detached, unattended session behaves while sitting on a post-escalation
# prompt is unverified against docs or a real run, so this is stated narrowly
# rather than assumed safe.
# --tmux keeps acceptEdits because a human is sitting with that session: their
# judgment is the one wanted there, and the prompts are no obstacle when someone
# is present to answer them.
#
# A delegate does NOT exit when its task completes: it stays at `status: idle`
# waiting for further input (a different state from `status: waiting` /
# `waitingFor: permission prompt`). It falls off the roster roughly an hour
# later, but that expiry fires no `SessionEnd` hook, so claude-queue is left
# with a ghost row whose `terminated_at` never gets filled in. Only `claude
# stop` (= `claude-stop-bg`) closes the tracking cleanly, which is why the
# delegator closes the session itself once it has the completion report --
# whether or not it replied to anything. Worktrees outlive the session either
# way; `git-reap-gone` reaps them.
#
# `--tmux` selects the other mode: claude is launched INSIDE a fresh detached
# tmux session (session name = <main repo basename>_<name>, the canonical
# convention -- see docs/design/claude-tmux-worktree.md; the worktree dir's own
# basename is just <name> under the .worktrees/ layout, so the repo half is
# composed back in).
# Running it in its own pane means its $TMUX_PANE is that new pane -- so
# claude-queue tracks it correctly instead of colliding with the launching pane.
# Attach any time (`gts <session>` / `tmux attach -t <session>`); it is
# interactive, so it keeps running at the REPL after the initial prompt -- no
# `claude --resume` needed. Use it when a human is meant to sit with the session.
#
# In `--tmux` mode, when invoked from inside tmux, the launch is wrapped so that
# when claude exits the attached client is switched back to the pane it was
# called from (not just the origin session's currently-active pane). Nobody
# attached / origin pane gone both degrade to a silent no-op.
#
# A new worktree only checks out the branch: gitignored / uncommitted files of the
# invoking checkout do NOT propagate, and reading outside the worktree still has
# no guarantee of passing the classifier described above (or, under --tmux, of
# getting an answer promptly). `--seed` copies such files in, so the delegated
# prompt can reference them relatively.
#
# The reverse direction has a reserved spot: `.delegate/` inside the worktree,
# added to the repo's exclude at creation. A delegate that stops short leaves
# what it wants to hand back there, where the delegator reads it by relative
# path and `git-reap-gone` still sees a clean worktree.
#
# Usage:
#   claude-worktree [--self] [--tmux] [--model <alias>] [--seed <path>]... <name> [-b <branch>] [-- <prompt...>]
#
#   --self         anchor the worktree to the repo this script lives in (e.g.
#                  your dotfiles repo), not cwd. Use for repo-independent work.
#   --tmux         launch the delegate in a detached tmux session running an
#                  INTERACTIVE claude instead of a background agent. Use when a
#                  human is meant to sit with it (working a design out together);
#                  the session stays at the REPL and is reached with `gts`.
#                  Runs with `acceptEdits`, not the background mode's `auto`:
#                  someone is present to answer prompts, and their judgment
#                  beats a classifier's in that setting.
#   --model <alias>
#                  pass --model <alias> to the launched claude (e.g. opus), so the
#                  caller picks the model for the role it is delegating. Omitted
#                  means claude keeps its inherited default model; an empty value
#                  is rejected rather than silently falling back to it.
#   --seed <path>  copy <path> from cwd's checkout into the same relative path in
#                  the new worktree (repeatable). For files the delegated session
#                  needs but which the branch does not carry (gitignored specs,
#                  uncommitted notes). Must live inside cwd's checkout.
#                  Paths listed in the checkout's `.claude/worktree-seed` are
#                  seeded on top of these, without being asked for; unlike an
#                  explicit --seed, a listed path that is missing is skipped
#                  rather than fatal. That default list only applies when cwd's
#                  repo IS the one being anchored to (see --self): an unrelated
#                  cwd repo's list is not read.
#   name           worktree label (suffix after the underscore); also the new
#                  branch name when -b is omitted
#   -b <branch>    branch to check out / create (default: <name>). A `git fetch
#                  origin` runs first (failure warns, never aborts), then the
#                  branch resolves as: local branch, else origin/<branch>
#                  (tracked), else created fresh from origin/HEAD -- falling
#                  back to origin/main, and only then to cwd's HEAD. A NEW
#                  branch deliberately does NOT start from cwd's HEAD: cwd is
#                  often a long-stale linked worktree, and a delegate branched
#                  from there reads the repo's own files as its reference
#                  implementation at whatever version that stale base carried.
#                  Which base was used is printed in the report below.
#   -- <prompt>    everything after `--` is the initial prompt. By default the
#                  delegate is started with `claude --bg` (permission mode
#                  `auto`, since nobody is there to approve prompts -- see the
#                  header) and is reached with `claude attach <short-id>`; it
#                  stays alive once the task completes, so the delegator closes
#                  it with `claude-stop-bg`. With --tmux, see above.

usage() {
  # Print the first contiguous "# " comment block (the description), skipping the
  # shebang and the leading code lines, stripping the leading "# ".
  awk '/^#!/ {next} /^#/ {sub(/^# ?/, ""); print; seen=1; next} seen {exit}' "$0"
  exit "${1:-1}"
}

[ $# -ge 1 ] || usage 1

name=""
branch=""
prompt=""
self=0
use_tmux=0
model=""
seeds=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage 0 ;;
    -b) shift; [ $# -gt 0 ] || usage 1; branch="$1"; shift ;;
    # Reject an EMPTY value instead of falling back to the inherited default: an
    # empty `--model` is almost always an unset variable at the call site
    # (`--model "$MODEL"`), and a fire-and-forget delegation nobody watches would
    # then quietly run on the wrong model. Rejecting it also makes the `model=""`
    # sentinel unambiguous -- empty can only mean "flag not given".
    --model)
      shift; [ $# -gt 0 ] || usage 1
      [ -n "$1" ] || { echo "claude-worktree: --model needs a non-empty alias" >&2; exit 1; }
      model="$1"; shift ;;
    --seed) shift; [ $# -gt 0 ] || usage 1; seeds+=("$1"); shift ;;
    --self) self=1; shift ;;
    --tmux) use_tmux=1; shift ;;
    --) shift; prompt="$*"; break ;;
    -*) echo "claude-worktree: unknown flag: $1" >&2; usage 1 ;;
    *)
      if [ -z "$name" ]; then name="$1"; shift
      else echo "claude-worktree: unexpected argument: $1" >&2; usage 1; fi ;;
  esac
done
[ -n "$name" ] || usage 1
# Reject tmux-unsafe characters in the worktree name: `.` and `:` are target
# delimiters in `tmux -t` (session:window.pane) and would break gts switching.
if [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "claude-worktree: name must match [A-Za-z0-9_-]+ (got: $name)" >&2
  exit 1
fi
branch="${branch:-$name}"

# By default anchor to cwd's repo; with --self anchor to the repo this script
# itself lives in (resolving any PATH symlink), so global harnesses land in the
# dotfiles repo even when cwd is an unrelated project.
repo_dir="."
if [ "$self" = 1 ]; then
  repo_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
fi
common_git="$(git -C "$repo_dir" rev-parse --path-format=absolute --git-common-dir)"
main_top="$(dirname "$common_git")"
wt_path="${main_top}/.worktrees/${name}"

# Seed sources are always resolved against cwd's checkout (the one holding the
# uncommitted files), even under --self. Resolved leniently because --self is
# meant to be usable from anywhere, including outside any checkout -- there is
# then simply nothing to seed from, which only the explicit --seed path treats
# as an error.
seed_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$seed_top" ] || seed_top="$(realpath -- "$seed_top")"

# Validate the seeds BEFORE creating the worktree: a missing or out-of-checkout
# seed means the delegated prompt would reference a file that never arrives, and
# the session stalls on its first read. Fail here rather than leave an orphan
# worktree behind.
seed_rels=()
if [ "${#seeds[@]}" -gt 0 ]; then
  if [ -z "$seed_top" ]; then
    echo "claude-worktree: --seed needs cwd to be inside a git checkout" >&2
    exit 1
  fi
  for seed in "${seeds[@]}"; do
    seed_abs="$(realpath -m -- "$seed")"
    if [ ! -e "$seed_abs" ]; then
      echo "claude-worktree: --seed path does not exist: $seed" >&2
      exit 1
    fi
    case "$seed_abs" in
      "$seed_top"/*) seed_rels+=("${seed_abs#"$seed_top"/}") ;;
      *) echo "claude-worktree: --seed path is outside $seed_top: $seed" >&2; exit 1 ;;
    esac
  done
fi

# Default seeds, declared by the repo rather than guessed by this script.
# `.claude/worktree-seed` lists one path per line (relative to the checkout root;
# blank lines and lines starting with `#` are ignored) that should follow the
# checkout into every new worktree. That is where a repo names the gitignored
# config a delegate cannot work without -- the file supplying its GitHub token,
# a local .env -- without every such filename having to be hardcoded here.
#
# Terms differ from an explicit --seed in exactly one place: a listed path that
# does not exist is skipped rather than fatal, because the list is written once
# for the repo while any given checkout may not have every entry. A malformed
# entry (absolute, or escaping the checkout) still fails loudly -- the list is
# committed and reviewed, so a bad line is a bug to surface, not to tolerate.
# Entries also passed as --seed are skipped, so nothing is copied or logged twice.
#
# Scoped to same-repo only: apply the DEFAULT list only when cwd's repo is the
# same repo the worktree is being anchored to (main_top). `--self` exists
# precisely so cwd can be an unrelated project repo (see usage) -- without this
# guard, that unrelated repo's own `.claude/worktree-seed` would be read and its
# entries copied into the anchor repo's worktree with no explicit request from
# the caller (confirmed by reproduction: an unrelated cwd repo's listed secret
# ended up seeded into the anchor repo's worktree under --self). Compare via
# --git-common-dir (not toplevel) so a cwd that is itself a linked worktree of
# the SAME repo as main_top still counts as same-repo. Explicit --seed is
# unaffected: the caller named that path, so it stays honored regardless.
seed_repo_common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
seed_main_top=""
[ -z "$seed_repo_common" ] || seed_main_top="$(dirname "$seed_repo_common")"

if [ -n "$seed_top" ] && [ "$seed_main_top" = "$main_top" ] && [ -f "$seed_top/.claude/worktree-seed" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"   # ltrim
    line="${line%"${line##*[![:space:]]}"}"   # rtrim
    case "$line" in
      ""|"#"*) continue ;;
      /*) echo "claude-worktree: worktree-seed entry must be relative: $line" >&2; exit 1 ;;
    esac
    entry_abs="$(realpath -m -- "$seed_top/$line")"
    case "$entry_abs" in
      "$seed_top"/*) ;;
      *) echo "claude-worktree: worktree-seed entry is outside $seed_top: $line" >&2; exit 1 ;;
    esac
    [ -e "$entry_abs" ] || continue
    entry_rel="${entry_abs#"$seed_top"/}"
    dup=0
    for rel in ${seed_rels[@]+"${seed_rels[@]}"}; do
      if [ "$rel" = "$entry_rel" ]; then dup=1; break; fi
    done
    [ "$dup" = 1 ] || seed_rels+=("$entry_rel")
  done <"$seed_top/.claude/worktree-seed"
fi

# A background session already living in this worktree means a second delegation
# would race the first on the same files. Refuse before creating anything, and
# name the existing session so the caller can reach it. Skipped when jq is
# absent: the guard is a convenience, not a correctness boundary.
if [ -n "$prompt" ] && [ "$use_tmux" = 0 ] && command -v jq >/dev/null 2>&1; then
  existing="$(claude agents --json 2>/dev/null | jq -r --arg d "$wt_path" \
    'first(.[] | select(.kind == "background" and .cwd == $d) | .sessionId[0:8]) // empty')"
  if [ -n "$existing" ]; then
    echo "claude-worktree: a background session is already running in $wt_path" >&2
    echo "  attach with: claude attach $existing" >&2
    exit 1
  fi
fi

# Refresh remote-tracking refs before resolving the branch. Two separate things
# below depend on refs that are only as current as the last fetch:
#
#   * a branch that exists ONLY on origin. Without a fetch the
#     `refs/remotes/origin/<branch>` check simply misses and the delegation
#     falls through to "create new", quietly ignoring the branch it was told to
#     work on.
#   * the base of a NEW branch (see below). A stale `origin/HEAD` would move the
#     problem rather than fix it.
#
# Failure is a warning, never fatal. Offline, or a checkout with no `origin` at
# all, must not stop a delegation from launching; the resolution below then just
# uses whatever refs are already present, which is the pre-fetch behavior.
# stdout is redirected to stderr so add-only mode's path-only stdout stays
# scriptable (git writes progress to stderr already, but not every transport
# does).
#
# GIT_TERMINAL_PROMPT=0 forces that "failure is a warning, never fatal" path
# for missing HTTPS credentials too. Without it, a credential helper with
# nothing cached makes git prompt for username/password on the controlling
# terminal instead of failing -- worse than failure, since this runs inside an
# unattended `claude --bg` delegation with nobody there to answer. It hangs
# forever rather than falling through to "use whatever refs are already
# present". BatchMode=yes closes the same hole for SSH remotes (passphrase /
# host-key prompts).
if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}" git -C "$repo_dir" fetch origin >&2; then
  echo "claude-worktree: git fetch origin failed; using the refs already present" >&2
fi

# Base for a NEW branch: the remote's default branch, NOT cwd's HEAD.
#
# cwd is routinely a long-lived linked worktree (a review-only checkout, a
# delegation that has been sitting for days). Branching from its HEAD gave the
# delegate a base arbitrarily far behind origin -- measured at 822 commits, on
# all three delegations out of one session. The damage is not the stale diff: it
# is that a prompt naming a file in the repo as the reference implementation has
# the delegate read the OLD version and copy it forward as if it were current.
# In a repo with generated artifacts it is worse than that, because regenerating
# from a stale base still produces no diff -- the idempotence check passes while
# the generated output reverts other PRs' changes, so no test can catch it.
#
# Prefer origin/HEAD, fall back to origin/main, then (only if neither resolves)
# to the previous behavior of cwd's HEAD -- matching git-reap-gone's ladder for
# the same question. The HEAD fallback is announced, since in add-only mode the
# stdout report below is not printed and this is the one case worth noticing.
new_base=""
if b="$(git -C "$repo_dir" rev-parse --abbrev-ref origin/HEAD 2>/dev/null)" && [ "$b" != "origin/HEAD" ]; then
  new_base="$b"
elif git -C "$repo_dir" rev-parse --verify --quiet origin/main >/dev/null; then
  new_base="origin/main"
fi

# Keep stdout clean (path only) so add-only mode is scriptable; git's checkout
# chatter goes to stderr.
#
# `base` records what the checked-out branch actually came from, so the report
# below can name it. A base decided silently is exactly how the staleness above
# went unnoticed for three delegations.
if [ -d "$wt_path" ]; then
  echo "claude-worktree: worktree dir already exists, reusing: $wt_path" >&2
  base="reused existing worktree dir"
elif git -C "$repo_dir" show-ref --verify --quiet "refs/heads/${branch}"; then
  git -C "$repo_dir" worktree add "$wt_path" "$branch" >&2               # existing local branch
  base="existing local branch $branch"
elif git -C "$repo_dir" show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
  # Branch has no local tracking branch but exists on origin: check it out
  # explicitly from origin/<branch> rather than relying on `git worktree add`'s
  # DWIM resolution. git-worktree(1) says a bare <branch> with no local match
  # behaves like `--track -b` only when it "uniquely" identifies a remote-tracking
  # branch across ALL remotes; with more than one remote (or none) the outcome
  # depends on checkout.defaultRemote. Naming `origin` explicitly makes this
  # deterministic regardless of remote configuration -- and matches this repo's
  # other origin-assuming script, git-reap-gone.
  git -C "$repo_dir" worktree add --track -b "$branch" "$wt_path" "origin/${branch}" >&2 # remote-only branch
  base="origin/$branch"
elif [ -n "$new_base" ]; then
  git -C "$repo_dir" worktree add -b "$branch" "$wt_path" "$new_base" >&2 # new branch off origin's default
  base="$new_base (new branch)"
else
  echo "claude-worktree: no origin/HEAD or origin/main; new branch based on cwd's HEAD" >&2
  git -C "$repo_dir" worktree add -b "$branch" "$wt_path" >&2 # new branch, no remote default to use
  base="HEAD (new branch; no origin default resolvable)"
fi

# Reserve `.delegate/` as the delegate's return channel: where it drops files it
# wants to hand back (a PR body draft, findings, a generated artifact) when it
# stops short and reports instead of finishing. It has to be somewhere the
# delegator can read WITHOUT a permission prompt -- i.e. inside the worktree --
# and it must not block cleanup, since a delegate that stopped short leaves the
# directory behind for `git-reap-gone`.
#
# `/.worktrees/` rides the same mechanism, for a different reason: worktrees
# now live INSIDE the main checkout (see the header), so a plain `git status`
# or `git add -A` run in the main checkout would otherwise see `.worktrees/<name>`
# as an untracked embedded repo -- `git add -A` even stages it as a gitlink
# (confirmed by reproduction: `warning: adding embedded git repository:
# .worktrees/foo`). `~/.config/git/ignore` (this repo's `dot/git/ignore`)
# already covers checkouts that ran `bin/deploy.sh`, but that symlink is
# machine-local (see dotrc-deploy.md) -- a fresh clone, a CI runner, or another
# contributor's machine has no such global ignore. Adding it here too closes
# that gap for every checkout regardless of deploy state; `dot/git/ignore` stays
# as defense in depth, not as the only layer.
#
# An exclude entry is what reconciles the `.delegate/` half of this:
# `git-reap-gone` refuses a worktree whose `git status --porcelain` is
# non-empty, so an untracked `.delegate/` would make the branch un-reapable;
# excluded, status stays empty and `git worktree remove` succeeds without
# --force. Doing it here
# rather than in .gitignore keeps the convention out of every branch's
# committed tree -- it is a property of delegation, not of the code. `/.worktrees/`
# has no such removability concern (nothing ever sits inside another worktree's
# own worktree dir), but sharing the mechanism means one exclude write covers
# both patterns with the same repeat-run and no-trailing-newline handling below.
#
# The entries land in the REPO-WIDE exclude, not a per-worktree one. `git
# rev-parse --git-path info/exclude` resolves to the common dir's
# `.git/info/exclude` even when asked from inside a linked worktree, and that is
# the only location git reads: writing the same pattern to
# `.git/worktrees/<name>/info/exclude` leaves `check-ignore` reporting the path
# as not ignored (measured on git 2.43.0). So the patterns are shared by every
# checkout of the repo -- harmless, since both are delegation/worktree-only
# paths every checkout wants ignored on its own side too.
#
# The path is still asked of git rather than assembled by hand: a linked
# worktree's `.git` is a FILE, so a hand-built path does not resolve and would
# fail while looking merely absent.
#
# Best-effort throughout: appending only when an entry is absent keeps a repeat
# run from duplicating it (it accumulates in shared repo state otherwise), and
# any failure here degrades to a warning rather than losing an otherwise-good
# worktree.
if exclude_path="$(git -C "$wt_path" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null)" \
   && [ -n "$exclude_path" ] \
   && mkdir -p "$(dirname "$exclude_path")" 2>/dev/null; then
  for pattern in '/.delegate/' '/.worktrees/'; do
    if ! { [ -f "$exclude_path" ] && grep -qxF "$pattern" "$exclude_path"; }; then
      # If the file already has content and its last byte isn't a newline,
      # appending directly would glue our pattern onto the existing last line
      # (e.g. an existing `/scratch/` with no trailing newline becomes
      # `/scratch//.delegate/`), silently corrupting that entry and never
      # registering ours. Insert the missing newline first so the append always
      # lands as its own line.
      if [ -s "$exclude_path" ] && [ "$(tail -c1 "$exclude_path" | wc -l)" -eq 0 ]; then
        printf '\n' >>"$exclude_path"
      fi
      printf '%s\n' "$pattern" >>"$exclude_path" \
        || echo "claude-worktree: could not add $pattern to $exclude_path" >&2
    fi
  done
else
  echo "claude-worktree: could not resolve the repo exclude; /.delegate/ and /.worktrees/ not ignored" >&2
fi

# Seed the worktree. Copies stay untracked when the source is gitignored, so they
# inform the delegated session without ever landing in a commit.
for rel in ${seed_rels[@]+"${seed_rels[@]}"}; do
  dst="$wt_path/$rel"
  mkdir -p "$(dirname "$dst")"
  rm -rf -- "$dst"   # so a directory seed replaces rather than nests inside
  cp -a -- "$seed_top/$rel" "$dst"
  echo "claude-worktree: seeded $rel" >&2
done

if [ -z "$prompt" ]; then
  echo "$wt_path"
  exit 0
fi

# Resolve the delegating session's name so the delegate can report back to it.
#
# A delegate has no conversation history and no way to guess who launched it.
# `claude agents --json` lists every live session with its pid, so walking this
# process's ancestors until one of them IS a listed session identifies the
# caller exactly -- no cwd heuristics, no ambiguity when several sessions share
# a directory. Returns empty (never fails the launch) when there is no claude
# ancestor, when the entry carries no name, or when jq is unavailable: a human
# running this from a plain shell has no delegator, and that is not an error.
resolve_delegator() {
  command -v jq >/dev/null 2>&1 || return 0
  local agents p name
  agents="$(claude agents --json 2>/dev/null)" || return 0
  [ -n "$agents" ] || return 0
  p=$$
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    name="$(printf '%s' "$agents" | jq -r --arg pid "$p" \
      'first(.[] | select(.pid == ($pid | tonumber)) | .name // empty) // empty')"
    if [ -n "$name" ]; then
      printf '%s' "$name"
      return 0
    fi
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
}

delegator="$(resolve_delegator)"

# Inject the name as a bare datum. What to report, and when, is doctrine and
# lives in the implement-and-review skill -- this script only supplies the fact
# the skill cannot derive. Appending to the prompt (rather than exporting an env
# var) is deliberate: `claude --bg` starts via a background service, so env
# inheritance is not guaranteed, whereas the prompt is the one channel that is.
if [ -n "$delegator" ]; then
  prompt="${prompt}

## 委譲元
報告先 name: ${delegator}"
fi

if [ "$use_tmux" = 0 ]; then
  # Background agent (default). It does NOT exit on its own when the task
  # completes -- see the header for that. It's preferred over an interactive
  # session because it doesn't occupy a tmux session/pane. Permission mode is
  # `auto` (NOT acceptEdits, which --tmux keeps): nobody is attached to answer a
  # prompt, so a classifier vets what the allowlist doesn't cover -- see the
  # header for why and for what the classifier still refuses. The id is
  # assigned by --bg (it ignores --session-id), so the only way to learn it is
  # to read the launch banner back.
  #
  # cwd matters: the delegate reads the checkout it is started in, so the launch
  # runs inside the worktree. A subshell keeps this script's own cwd untouched.
  # Under `set -e`, an assignment's exit status IS the command substitution's
  # exit status: a bare `launch_out="$(... claude ...)"` would abort the script
  # right here if claude itself failed, discarding the just-captured stderr
  # along with it. Since a delegation is fire-and-forget, that leaves the
  # caller with nothing but an unexplained rc=1. The `if cmd; then :; else ...`
  # shape (NOT `if ! cmd; then`) is deliberate: negating the condition with `!`
  # also negates the exit status `$?` sees inside the branch, so `rc=$?` there
  # would read back 0 even though claude failed. Falling through to `else`
  # keeps `$?` as claude's real exit code.
  if [ -n "$model" ]; then
    if launch_out="$(cd "$wt_path" && claude --bg --permission-mode auto --model "$model" "$prompt" 2>&1)"; then
      :
    else
      rc=$?
      echo "claude-worktree: claude --bg failed (exit $rc); worktree left at $wt_path:" >&2
      printf '%s\n' "$launch_out" >&2
      exit "$rc"
    fi
  else
    if launch_out="$(cd "$wt_path" && claude --bg --permission-mode auto "$prompt" 2>&1)"; then
      :
    else
      rc=$?
      echo "claude-worktree: claude --bg failed (exit $rc); worktree left at $wt_path:" >&2
      printf '%s\n' "$launch_out" >&2
      exit "$rc"
    fi
  fi

  # `backgrounded · <id>`. Pull the first 8-hex-char field off that line rather
  # than matching the separator, which is a multibyte middle dot.
  short="$(printf '%s\n' "$launch_out" \
    | awk '/backgrounded/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9a-f]{8}$/) { print $i; exit } }')"

  echo "worktree : $wt_path"
  echo "branch   : $branch"
  echo "base     : $base"
  if [ -n "$short" ]; then
    echo "session  : $short (background; auto)"
  else
    # The session IS running -- only the id is unknown. Surfacing the raw banner
    # beats printing a report with a silently empty field.
    echo "claude-worktree: could not read the session id from the launch output:" >&2
    printf '%s\n' "$launch_out" >&2
  fi
  [ -z "$model" ] || echo "model    : $model"
  [ -z "$delegator" ] || echo "report-to: $delegator"
  [ -z "$short" ] || echo "attach   : claude attach $short"
  exit 0
fi

# --tmux: detached tmux session running an interactive claude.
# Session name = <main repo basename>_<name> (canonical convention, see
# docs/design/claude-tmux-worktree.md). The worktree dir basename is just <name>
# now that worktrees live under <repo>/.worktrees/, so the repo half is composed
# back in here; both halves are tmux-safe (a dot would be misparsed as a
# window.pane delimiter in `tmux -t` targets).
session="$(basename "$main_top")_${name}"

if tmux has-session -t "=$session" 2>/dev/null; then
  echo "claude-worktree: tmux session '$session' already exists; not launching a" >&2
  echo "  second claude. Attach with: gts $session" >&2
  exit 1
fi

# Start claude INSIDE a fresh detached tmux session in the worktree. Passing the
# prompt as a separate argv element keeps spaces/quotes intact (tmux preserves
# argv). Interactive (no -p) so it stays at the REPL after the first prompt.
#
# Permission mode stays `acceptEdits` here -- the background launch above uses
# `auto`, and that difference is intentional: this mode exists for a human to sit
# with the session, so approval prompts cost nothing and their judgment is
# preferred over the classifier's (see the header).
#
# When launched from inside tmux, wrap the launch in `bash -c` so that when
# claude exits we chain `switch-client -t <origin_pane>`, returning the attached
# client to the exact pane we were called from (session-level auto-return only
# lands on the origin session's active pane, not this one). The prompt and pane
# id ride in as positional args ($1/$2) -- never folded into the command string
# -- so quotes in the prompt can't break the chain. If nobody is attached, or
# the origin pane is already gone, switch-client is a graceful no-op (2>/dev/null)
# and the single-pane session just dies quietly when the inner bash exits.
#
# --model rides in as a positional arg too ($3, empty when unset) rather than
# being interpolated into the command string, for the same quoting reason. An
# empty model must not degrade to `--model ""` (claude would reject it), so each
# launch shape branches on it and omits the flag entirely when it is unset.
if [ -n "${TMUX:-}" ]; then
  tmux new-session -d -s "$session" -c "$wt_path" \
    bash -c 'if [ -n "$3" ]; then claude --permission-mode acceptEdits --model "$3" "$1"; else claude --permission-mode acceptEdits "$1"; fi; tmux switch-client -t "$2" 2>/dev/null' \
    bash "$prompt" "$TMUX_PANE" "$model"
elif [ -n "$model" ]; then
  tmux new-session -d -s "$session" -c "$wt_path" \
    claude --permission-mode acceptEdits --model "$model" "$prompt"
else
  tmux new-session -d -s "$session" -c "$wt_path" \
    claude --permission-mode acceptEdits "$prompt"
fi

attach="gts $session"
[ -n "${TMUX:-}" ] || attach="tmux attach -t $session"

echo "worktree : $wt_path"
echo "branch   : $branch"
echo "base     : $base"
echo "session  : $session (detached; claude running with acceptEdits)"
[ -z "$model" ] || echo "model    : $model"
[ -z "$delegator" ] || echo "report-to: $delegator"
echo "attach   : $attach"
