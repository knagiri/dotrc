#!/usr/bin/env bash
set -euo pipefail

# gh-automerge <PR#> -- merge a pull request, preferring auto-merge.
# gh-automerge --disable <PR#> -- turn its auto-merge off again (see below).
#
# Runs EXACTLY `gh pr merge --auto --merge <PR>` with no flag passthrough, so a
# caller (incl. a prompt-injected reviewer agent) cannot append --admin or other
# protection-bypassing flags. This lets the merge grant be allowlisted narrowly
# as `Bash(gh-automerge *)` instead of the broad `gh pr merge *`.
#
# Clean-status fallback: GitHub's enablePullRequestAutoMerge refuses a PR whose
# mergeStateStatus is CLEAN with "Pull request is in clean status" -- there is
# nothing left to wait for, so there is no auto-merge to enable. A repo without
# CI workflows lands in that state almost immediately, which makes auto-merge
# structurally unreachable. On exactly that refusal we fall back to
# `gh pr merge --merge <PR>`, a direct merge that GitHub still gates on branch
# protection (required checks / approvals); this wrapper bypasses nothing, and
# --admin remains unreachable. Any other failure (unmet required check,
# conflict, ...) is passed back to the caller untouched.
#
# --disable: `gh-automerge --disable <PR#>` turns an already enabled auto-merge
# off again, for the window in which more fix commits are pushed onto an open PR
# (implement-and-review, "既存 PR への対応"). Without it, auto-merge enabled in an
# earlier round fires as soon as the required conditions (approval, CI, ...)
# are met by one of those pushes, before the new review round has finished.
# Re-enabling is the normal `gh-automerge <PR#>` call that pr-automerge makes once the review converges.
#   - state MERGED / CLOSED -> exit 3, nothing issued (also when the re-read
#     after --disable-auto shows it, i.e. auto-merge fired in between). Pushing more commits to
#     that branch would land nowhere, so the caller must stop rather than push;
#     3 keeps this apart from 1 (bad arguments).
#   - autoMergeRequest null -> exit 0, nothing issued (idempotent). We decide
#     this from the PR state ourselves instead of relying on how
#     `gh pr merge --disable-auto` treats a PR with nothing to disable.
#   - otherwise -> `gh pr merge --disable-auto <PR#>`, then read the PR again: OPEN with
#     autoMergeRequest null -> exit 0, MERGED / CLOSED -> exit 3, else exit 1.
# The accepted forms are exactly the two below; no other option is parsed or
# passed through, so --admin stays unreachable in both.
#
# Usage: gh-automerge <PR-number>
#        gh-automerge --disable <PR-number>

usage() {
  echo "usage: gh-automerge <PR-number>" >&2
  echo "       gh-automerge --disable <PR-number>" >&2
  exit "${1:-1}"
}

disable=0
case "${1:-}" in
  -h|--help) [ $# -eq 1 ] || usage 1; usage 0 ;;
  --disable) disable=1; shift ;;
esac
[ $# -eq 1 ] || usage 1
pr="$1"
if [[ ! "$pr" =~ ^[0-9]+$ ]]; then
  echo "gh-automerge: PR number must be numeric (got: $pr)" >&2
  exit 1
fi

# Every gh call goes through gh_mise so the repo's mise-provided env (GH_TOKEN)
# is loaded even in a non-interactive process; see bin/lib/gh-mise.sh.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/gh-mise.sh"
gh_mise_use "$(gh_mise_repo_root)"

if [ "$disable" -eq 1 ]; then
  # One line: "<state> <true|false>", the latter whether auto-merge is enabled.
  read_state() {
    gh_mise pr view "$pr" --json state,autoMergeRequest \
      --jq '"\(.state) \(.autoMergeRequest != null)"'
  }
  view="$(read_state)"
  case "$view" in
    "MERGED "*|"CLOSED "*)
      echo "gh-automerge: #$pr is ${view%% *}; do not push to its branch" >&2
      exit 3 ;;
    *" false")
      echo "gh-automerge: auto-merge is already disabled on #$pr" >&2
      exit 0 ;;
    *" true") ;;
    *)
      echo "gh-automerge: unexpected PR state for #$pr: $view" >&2
      exit 1 ;;
  esac
  gh_mise pr merge --disable-auto "$pr"
  view="$(read_state)"
  # Auto-merge may have fired between the first read and --disable-auto, so
  # the state matters here too, not just the flag: a bare "false" after a
  # merge would tell the caller to push to a branch that has already landed.
  case "$view" in
    "OPEN false")
      echo "gh-automerge: disabled auto-merge on #$pr" >&2
      exit 0 ;;
    "MERGED "*|"CLOSED "*)
      echo "gh-automerge: #$pr became ${view%% *} while disabling; do not push to its branch" >&2
      exit 3 ;;
    *)
      echo "gh-automerge: auto-merge is still enabled or the state is unexpected on #$pr after --disable-auto ($view)" >&2
      exit 1 ;;
  esac
fi

err="$(mktemp)"
trap 'rm -f "$err"' EXIT

rc=0
gh_mise pr merge --auto --merge "$pr" 2>"$err" || rc=$?
cat "$err" >&2
if [ "$rc" -eq 0 ]; then
  echo "gh-automerge: enabled auto-merge on #$pr" >&2
  exit 0
fi

if ! grep -qi 'clean status' "$err"; then
  exit "$rc"
fi

echo "gh-automerge: auto-merge refused (#$pr is in clean status); merging directly" >&2
gh_mise pr merge --merge "$pr"
