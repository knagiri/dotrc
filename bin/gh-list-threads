#!/usr/bin/env bash
set -euo pipefail

# gh-list-threads <PR#> -- print the PR's review threads as a JSON array.
#
# Read-only reviewThreads GraphQL query. Output is the bare thread list, not the
# GraphQL envelope:
#
#   [{"id": ..., "isResolved": ..., "isOutdated": ...,
#     "comments": {"nodes": [{"author": {"login": ...}, "body": ..., "path": ..., "line": ...}]}}, ...]
#
# so `[.[] | select(.isResolved == false)] | length` counts unresolved threads.
# Against the envelope that same filter raises no error and yields 0: `.[]` walks
# into the single `data` object, which has no `.isResolved`, and `null == false`
# is false -- an "all resolved" that looks safe and is wrong. The unwrap lives
# here so the obvious filter is the correct one.
#
# Wrapped so the reviewer can enumerate threads without a broad `gh api graphql *`
# grant; allowlist as `Bash(gh-list-threads *)`. owner/repo and the unwrap both use
# gh's built-in --jq (no system jq needed).
#
# Usage: gh-list-threads <PR-number>

usage() { echo "usage: gh-list-threads <PR-number>" >&2; exit "${1:-1}"; }

[ $# -eq 1 ] || usage 1
case "$1" in -h|--help) usage 0 ;; esac
pr="$1"
if [[ ! "$pr" =~ ^[0-9]+$ ]]; then
  echo "gh-list-threads: PR number must be numeric (got: $pr)" >&2
  exit 1
fi

# Every gh call goes through gh_mise so the repo's mise-provided env (GH_TOKEN)
# is loaded even in a non-interactive process; see bin/lib/gh-mise.sh.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/gh-mise.sh"
gh_mise_use "$(gh_mise_repo_root)"

owner_repo="$(gh_mise repo view --json owner,name --jq '.owner.login + " " + .name')"
owner="${owner_repo%% *}"
repo="${owner_repo##* }"

gh_mise api graphql \
  -f query='query($owner:String!,$repo:String!,$pr:Int!){
    repository(owner:$owner,name:$repo){ pullRequest(number:$pr){
      reviewThreads(first:100){ nodes{ id isResolved isOutdated
        comments(first:30){ nodes{ author{login} body path line } } } } } } }' \
  -f owner="$owner" -f repo="$repo" -F pr="$pr" \
  --jq '.data.repository.pullRequest.reviewThreads.nodes'
