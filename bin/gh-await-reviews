#!/usr/bin/env bash
set -euo pipefail

# gh-await-reviews <PR#> -- block until the PR's automated reviews have settled,
# then print a detection report as JSON. Prints the report and exits 0 even on
# timeout: a missing reviewer is information, not an error.
#
# Waiting and tracking are different problems. We can only *wait* for a reviewer
# detectable BEFORE it posts. In this repo Copilot's pending review does NOT
# surface in reviewRequests (measured: empty across the whole pre-arrival window)
# nor as a check, so today nothing is predictable and `expected` stays empty --
# the REQ machinery below is kept as a forward-compatible hook. Everyone --
# Copilot, CodeRabbit, claude, humans -- is knowable only after the fact, so they
# are *tracked*: any participant other than the PR author who appears in
# reviews/comments is recorded and resets the quiet timer. No bot/human
# classification is attempted; gh does not expose is_bot here, and login
# heuristics are brittle.
#
# Quiet is measured from real submittedAt/createdAt timestamps rather than from
# when this script started, so an already-reviewed PR returns immediately.
#
# Only activity aimed at the current HEAD counts. Right after a fix push, the
# PR still carries the previous commit's review, already old enough to pass the
# quiet window; counting it would settle instantly, and the new commit's review
# would land minutes later as a "late" review that costs the caller a whole
# extra review round. So a review counts only when its commit.oid equals
# headRefOid, and a standalone comment (which carries no commit) only when it
# is newer than the HEAD commit's committedDate. headRefOid is re-read every
# poll so a push made while waiting is followed. Presence is judged separately
# from arrival: a Copilot review on *any* commit means this PR has Copilot, so
# `expected` stays non-empty until a HEAD-targeted Copilot review arrives or
# the timeout fires. A repo whose bot does not re-review new pushes therefore
# waits out the full timeout on every call after a push; the caller treats
# `timed_out` as information, not as a merge blocker.
#
# An empty `expected` is ambiguous: it can mean "no review bot on this repo" or
# "a bot is present but hasn't posted anything yet (an unpredictable reviewer
# may still be booting)". Settling on it right after PR creation is therefore
# unsound (see $expected_floor_s), and the report carries `expected_unknown` so
# callers do not read `expected: []` as proof that no bot will review.
#
# Wrapped so the reviewer agent needs no `sleep` grant. Allowlist as
# `Bash(gh-await-reviews *)`. Requires jq (see bin/list-install.sh).
#
# Usage: gh-await-reviews <PR-number>

usage() { echo "usage: gh-await-reviews <PR-number>" >&2; exit "${1:-1}"; }

[ $# -eq 1 ] || usage 1
case "$1" in -h|--help) usage 0 ;; esac
pr="$1"
if [[ ! "$pr" =~ ^[0-9]+$ ]]; then
  echo "gh-await-reviews: PR number must be numeric (got: $pr)" >&2
  exit 1
fi

# Every gh call goes through gh_mise so the repo's mise-provided env (GH_TOKEN)
# is loaded even in a non-interactive process; see bin/lib/gh-mise.sh.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/gh-mise.sh"
gh_mise_use "$(gh_mise_repo_root)"

timeout_s=${GH_AWAIT_REVIEWS_TIMEOUT:-600}   # overall ceiling
quiet_s=${GH_AWAIT_REVIEWS_QUIET:-30}        # silence after the last activity
grace_s=${GH_AWAIT_REVIEWS_GRACE:-60}        # floor when nothing is expected and nothing posted
poll_s=${GH_AWAIT_REVIEWS_POLL:-15}
# Floor, measured from the later of PR creation and the HEAD commit's
# committedDate, below which an empty `expected` may not be settled on. The HEAD
# commit time is only a proxy for the push (a commit made well before its push
# already satisfies the floor on arrival), so the HEAD-targeted activity filter
# described in the header is what actually closes the post-push gap; the floor
# just keeps a freshly pushed PR from being declared bot-free instantly. As the header comment says, Copilot's pending review never
# surfaces in reviewRequests in this repo, so an empty `expected` never means
# "registration hasn't finished" -- it means nothing has been observed *yet*.
# The floor exists so the script doesn't conclude "no automated review" before
# an unpredictable reviewer has had a realistic chance to actually post; it
# does not guarantee `expected` fills in by the time it elapses (Copilot may
# still stay silent), and once it elapses an empty `expected` is accepted as
# the best available signal, not proof the ambiguity was resolved.
#
# Measured on a PR in another repo (dotrc's own PR history hasn't yet produced
# one slow enough to exercise this floor): settled at 63s with an empty
# expected/observed, yet a Copilot review landed shortly after -- i.e. 63s was
# too short for Copilot to have posted, not evidence reviewRequests was still
# registering.
expected_floor_s=${GH_AWAIT_REVIEWS_EXPECTED_FLOOR:-90}

# One gh call per poll. Emits, per line:
#   CRT<TAB><iso8601>            when the PR was created
#   HED<TAB><sha>                headRefOid
#   HDT<TAB><iso8601>            the HEAD commit's committedDate
#   REQ<TAB><login>              a pending review request (pre-arrival signal)
#   RVW<TAB><login>              someone other than the author reviewed *some* commit
#   ACT<TAB><login><TAB><iso8601> a HEAD-targeted review, or a comment newer than
#                                the HEAD commit, by someone other than the author
# The HEAD commit is looked up by oid and falls back to the last listed commit.
# An empty headRefOid / committedDate disables the corresponding filter (fail
# open to counting everything) rather than dropping every activity.
snapshot() {
  gh_mise pr view "$pr" --json author,createdAt,headRefOid,commits,reviewRequests,reviews,comments --jq '
    .author.login as $a
    | (.headRefOid // "") as $h
    | ((.commits // []) | ((map(select(.oid == $h)) | last) // last)) as $hc
    | (($hc // {}).committedDate // "") as $hd
    | "CRT\t" + (.createdAt // ""),
      "HED\t" + $h,
      "HDT\t" + $hd,
      ([.reviewRequests[]?.login // empty] | .[] | "REQ\t" + .),
      ([.reviews[]? | .author.login | select(. != $a)] | unique | .[] | "RVW\t" + .),
      (([.reviews[]?  | select($h == "" or .commit.oid == $h)
                      | {l: .author.login, t: .submittedAt}]
      + [.comments[]? | select($hd == "" or (.createdAt // "") > $hd)
                      | {l: .author.login, t: .createdAt}])
       | .[] | select(.l != $a) | "ACT\t" + .l + "\t" + (.t // ""))
  '
}

started=$(date -u +%s)
expect_copilot=0
copilot_at=""
created_at=""
head_sha=""
head_at=""
last_ts=""
observed=""   # "<login><TAB><ts>" per line, may repeat a login

# jq builds the report so logins and timestamps get escaped properly and the
# observed list is deduplicated (latest timestamp wins per login).
emit() {  # $1 = settled|timed_out
  printf '%s' "$observed" | jq -Rsc \
    --argjson pr "$pr" \
    --arg status "$1" \
    --argjson waited "$(( $(date -u +%s) - started ))" \
    --argjson expect_copilot "$expect_copilot" \
    --arg copilot_at "$copilot_at" \
    --arg head_sha "$head_sha" '
    (split("\n") | map(select(. != "") | split("\t") | {login: .[0], at: .[1]})
      | group_by(.login) | map(max_by(.at))) as $observed
    | (if $expect_copilot == 1
       then [{name: "copilot", signal: "review_request",
              arrived: ($copilot_at != ""),
              at: (if $copilot_at == "" then null else $copilot_at end)}]
       else [] end) as $expected
    | {pr: $pr,
       head_sha: (if $head_sha == "" then null else $head_sha end),
       settled: ($status == "settled"),
       timed_out: ($status == "timed_out"),
       waited_seconds: $waited,
       expected: $expected,
       expected_unknown: (($expected | length) == 0),
       observed: $observed,
       missing: [$expected[] | select(.arrived | not) | .name],
       last_activity_at: (($observed | map(.at) | max) // null)}
  '
}

# False while an empty `expected` is still too fresh to be believed. Fails open
# (settle allowed) when the PR age is unknown, so a parse failure cannot hang
# the caller.
#
# created_epoch is resolved into a plain variable *before* the arithmetic
# comparison below. Inlining `$(date ... "$created_at" +%s)` directly inside
# `$(( ))` is a trap: under `set -euo pipefail`, an unparseable created_at
# makes `date` fail and print nothing, so the arithmetic expression becomes
# `now - ` -- a bash *expansion* error, which is fatal even in a subshell-free
# context and kills the whole script before it ever prints the JSON report
# (violates the "prints and exits 0 even on timeout/error" contract at the
# top of this file). Resolving to a variable first lets us `return 0` (fail
# open) on a bad parse instead of crashing.
#
# (The same inline-date trap applies to the quiet-window check in the main
# loop below -- see the comment there instead of duplicating it here.)
expected_settled() {
  [ "$expect_copilot" -eq 0 ] || return 0
  local created_epoch="" head_epoch="" base_epoch
  if [ -n "$created_at" ]; then
    created_epoch=$(date -u -d "$created_at" +%s 2>/dev/null) || created_epoch=""
  fi
  if [ -n "$head_at" ]; then
    head_epoch=$(date -u -d "$head_at" +%s 2>/dev/null) || head_epoch=""
  fi
  # Whichever of the two parsed; the later one when both did.
  base_epoch=${created_epoch:-$head_epoch}
  if [ -n "$head_epoch" ] && [ "$head_epoch" -gt "$base_epoch" ]; then
    base_epoch=$head_epoch
  fi
  [ -n "$base_epoch" ] || return 0
  [ $(( now - base_epoch )) -ge "$expected_floor_s" ]
}

while :; do
  observed=""
  head_sha=""
  head_at=""
  while IFS=$'\t' read -r kind login ts; do
    case "$kind" in
      CRT) created_at="$login" ;;
      HED) head_sha="$login" ;;
      HDT) head_at="$login" ;;
      REQ|RVW) case "$login" in *[Cc]opilot*) expect_copilot=1 ;; esac ;;
      ACT) observed+="$login"$'\t'"$ts"$'\n' ;;
    esac
  done < <(snapshot)

  # A copilot review that already landed proves copilot was expected, even
  # though the review request has since disappeared from reviewRequests. RVW
  # above covers reviews on earlier commits; copilot_at below is HEAD-only.
  copilot_at=$(printf '%s' "$observed" | awk -F'\t' 'tolower($1) ~ /copilot/ {print $2}' | sort | tail -n1)
  if [ -n "$copilot_at" ]; then expect_copilot=1; fi

  # ISO-8601 UTC sorts lexicographically, so plain sort finds the newest.
  last_ts=$(printf '%s' "$observed" | cut -f2 | grep -v '^$' | sort | tail -n1 || true)

  now=$(date -u +%s)
  waited=$(( now - started ))

  if [ "$expect_copilot" -eq 0 ] && [ -z "$last_ts" ]; then
    # Nothing predicted and nobody has spoken. Don't conclude "no automated
    # review" instantly -- an unpredictable reviewer may still be booting.
    if [ "$waited" -ge "$grace_s" ] && expected_settled; then emit settled; exit 0; fi
  elif [ "$expect_copilot" -eq 0 ] || [ -n "$copilot_at" ]; then
    # Everything we can wait for has arrived; wait out the quiet window so a
    # reviewer that posts a summary first and inline comments second is caught.
    #
    # last_ts is resolved to last_epoch first, not inlined in `$(( ))` -- see
    # the comment above expected_settled() for why inlining `date` here would
    # be fatal under `set -euo pipefail` on a bad parse. Fails open (quiet
    # window treated as elapsed) so an unparseable timestamp still reaches
    # `emit` instead of crashing before any JSON is printed.
    last_epoch=$(date -u -d "$last_ts" +%s 2>/dev/null) || last_epoch=""
    if { [ -z "$last_epoch" ] || [ $(( now - last_epoch )) -ge "$quiet_s" ]; } && expected_settled; then
      emit settled; exit 0
    fi
  fi

  if [ "$waited" -ge "$timeout_s" ]; then emit timed_out; exit 0; fi
  sleep "$poll_s"
done
