#!/usr/bin/env bash
set -euo pipefail

# claude-reap-bg [--dry-run] [--idle-minutes <n>] [<short-id>...] -- conservatively
# stop background claude sessions that finished and were never closed.
#
# A delegated background session does NOT end when its task ends: it sits at
# `idle` waiting for further input and, roughly an hour later, disappears
# without firing SessionEnd, leaving a ghost row in claude-queue. The primary
# fix is for the delegator to run claude-stop-bg once it has the completion
# report -- this sweep only picks up what that path dropped.
#
# Deciding "finished" from the outside is guesswork, so every candidate must
# clear ALL of these; anything short of that is SKIPPED with the blocking
# reason, never stopped on a hunch:
#   * the roster (`claude agents --json`) says kind=="background" and
#     status=="idle" -- a busy session is still working.
#   * claude-queue's latest event for it is idle_done (the Stop hook), and that
#     event is at least --idle-minutes old (default 15). The queue is the only
#     record of WHEN the turn ended; the roster has no timestamp for it.
#   * the last assistant turn in the transcript contains no SendMessage
#     tool_use. A delegate that asked its delegator a question and is waiting
#     for the reply also sits at `idle`, and killing that discards live work.
#     This is the check that makes a bulk sweep safe at all -- it is exactly the
#     case claude-stop-bg's header calls out as the reason it has no sweep of
#     its own.
#     EXCEPT for an orphan: a session claude-queue's session_links records as
#     delegated by a parent that no roster entry carries any more (a pid-less
#     stale job record still counts as present). Its question can never be
#     answered, so this check -- and the transcript it needs -- is skipped for
#     it; every other gate still applies, and the report says `orphan: parent
#     <id> gone`. See docs/design/claude-queue-session-tree.md.
#
# The roster is read once PER CLAUDE_CONFIG_DIR, over the dirs the claude-queue
# ledger names plus the default (bin/lib/claude-configdir.sh). The ledger records
# every session on the host, but the roster and the daemon answering it are per
# dir, so a single read under this process's own environment would report every
# session of every other dir as absent -- and absence is not a gate here, it is
# simply invisibility, so those sessions would never be swept at all. A dir whose
# roster cannot be read is reported and skipped rather than treated as empty.
#
# Stopping goes through claude-stop-bg, never `claude stop` directly, so that
# wrapper's guard (refuse anything not kind=="background", refuse ambiguous
# ids) still applies on top of the checks here. It resolves the config dir from
# the same ledger, so the stop lands in the dir the session actually runs in.
#
# Separately, the roster also reports background jobs whose process is already
# gone: a kind=="background" entry with no `pid`. Its source is
# <config dir>/jobs/<id>/state.json, and a job left at state `blocked` never
# transitions to `stopped`, so the entry outlives the process forever. Such an
# entry has no `status` either, so the gates above can never see it -- it is a
# stale record, not a session. Those are REPORTED in a third section and
# nothing else: there is no process to stop, and the job directory routinely
# holds artifacts (PR drafts, backups), so removing it is the human's call. The
# detection is `kind == "background" and pid == null`; `state` is printed as a
# diagnostic but never used to decide, since it is claude's own internal
# vocabulary and free to change. `kind` is required alongside `pid` because an
# interactive entry can also lack a `pid`, and ~/.claude/jobs/<id> only ever
# exists for background jobs -- without the kind check such an entry's
# sessionId prefix would be reported as a job id backed by no such directory.
#
# Manual, best-effort: exits 0 even when candidates are skipped. There is no
# cron/daemon on purpose -- an unattended killer of sessions is exactly what
# the conservative predicates above are trying to avoid becoming.
#
# Usage:
#   claude-reap-bg [--dry-run] [--idle-minutes <n>] [<short-id>...]
#
#   --dry-run           report what would be stopped, stop nothing
#   --idle-minutes <n>  age the idle_done event must reach (default 15)
#   <short-id>...       restrict the sweep to these 8-hex-char ids (still fully
#                       gated; ids that are not live idle background sessions
#                       are reported skipped, or listed as stale job records)

usage() {
  awk '/^#!/ {next} /^#/ {sub(/^# ?/, ""); print; seen=1; next} seen {exit}' "$0"
  exit "${1:-1}"
}

dry_run=0
idle_minutes=15
declare -a filters=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage 0 ;;
    --dry-run) dry_run=1; shift ;;
    --idle-minutes)
      [ $# -ge 2 ] || { echo "claude-reap-bg: --idle-minutes needs a value" >&2; exit 1; }
      idle_minutes="$2"; shift 2 ;;
    --idle-minutes=*) idle_minutes="${1#*=}"; shift ;;
    --) shift; while [ $# -gt 0 ]; do filters+=("$1"); shift; done ;;
    -*) echo "claude-reap-bg: unknown flag: $1" >&2; usage 1 ;;
    *) filters+=("$1"); shift ;;
  esac
done

if [[ ! "$idle_minutes" =~ ^[0-9]+$ ]]; then
  echo "claude-reap-bg: --idle-minutes wants a non-negative integer: $idle_minutes" >&2
  exit 1
fi
idle_seconds=$(( idle_minutes * 60 ))

for tool in claude jq sqlite3; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "claude-reap-bg: $tool is required" >&2
    exit 1
  }
done

command -v claude-stop-bg >/dev/null 2>&1 || {
  echo "claude-reap-bg: claude-stop-bg is required (stopping never bypasses it)" >&2
  exit 1
}

db="${CLAUDE_QUEUE_DB:-$HOME/.claude/session-queue.db}"
[ -f "$db" ] || {
  echo "claude-reap-bg: no claude-queue database at $db" >&2
  exit 1
}

# Report accumulators, mirroring git-reap-gone. Each entry is "<id>\t<detail>".
declare -a reaped=()
declare -a skipped=()
reap_ok()   { reaped+=("$1"$'\t'"$2"); }
reap_skip() { skipped+=("$1"$'\t'"$2"); }

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/claude-configdir.sh"

# Fetch each config dir's roster as its own step (rather than piping into jq) so
# a fetch failure gets a diagnostic instead of `set -e` exiting silently, and so
# one unreadable dir does not cost the sweep the readable ones. The entries are
# concatenated into one array, since every gate below keys off the session id
# and claude-stop-bg re-derives the dir from the ledger anyway.
declare -a config_dirs=()
while IFS= read -r d; do
  [ -n "$d" ] || continue
  config_dirs+=("$d")
done < <(cq_config_dirs)

# Each dir's entries are tagged with the dir they came from before being merged,
# so the stale-job section below can name the right <config dir>/jobs/<id> path.
# Nothing else needs the tag: every gate keys off the session id, and
# claude-stop-bg re-derives the dir from the ledger itself.
roster="[]"
read_any=0
for d in "${config_dirs[@]}"; do
  if ! dir_roster="$(CLAUDE_CONFIG_DIR="$d" claude agents --json 2>/dev/null)"; then
    echo "claude-reap-bg: could not read the session roster under $d; its sessions are not swept" >&2
    continue
  fi
  # A merge that fails leaves the accumulated roster untouched rather than
  # overwriting it with jq's partial output, so one malformed dir costs only its
  # own entries.
  if ! merged="$(jq -s --arg dir "$d" '.[0] + [ .[1][] | .configDir = $dir ]' \
                   <<<"$roster"$'\n'"$dir_roster" 2>/dev/null)"; then
    echo "claude-reap-bg: could not parse the session roster under $d; its sessions are not swept" >&2
    continue
  fi
  roster="$merged"
  read_any=1
done
if [ "$read_any" = 0 ]; then
  echo "claude-reap-bg: could not read the session roster under any config dir" >&2
  exit 1
fi

# Read the whole queue view once and match ids in bash afterwards. Building a
# per-session SQL string would mean interpolating roster-supplied text into a
# query; reading everything up front removes that question entirely.
queue="$(sqlite3 -separator $'\t' "$db" \
  "SELECT session_id, raw_state, created_at, COALESCE(transcript_path, '') FROM queue")" || {
  echo "claude-reap-bg: could not read the claude-queue database at $db" >&2
  exit 1
}

# Delegation links, read once for the same reason. Unlike the queue they are
# optional: a database from before session_links existed, or any other read
# failure, only means no session can be recognised as an orphan, which is
# exactly the behaviour without links -- so warn and carry on.
if ! links="$(sqlite3 -separator $'\t' "$db" \
  "SELECT child_short, parent_session_id FROM session_links" 2>/dev/null)"; then
  echo "claude-reap-bg: could not read session_links; treating every session as unlinked" >&2
  links=""
fi

# Every sessionId the roster lists, stale job records included: the orphan test
# asks whether a parent is gone, and a record still standing is not proof of
# that, so it counts as present.
declare -a roster_sids=()
while IFS= read -r rsid; do
  [ -n "$rsid" ] || continue
  roster_sids+=("$rsid")
done < <(jq -r '.[] | .sessionId // empty' <<<"$roster")

# last_turn_sent_message <transcript.jsonl> -- true when the most recent
# assistant turn issued a SendMessage.
#
# "Turn" is the run of assistant entries after the last real user prompt. Tool
# results also arrive as type=="user" entries, so they are excluded by shape
# (content is a string or contains something other than tool_result); counting
# them would cut every turn down to its final tool call. Sidechain entries are
# subagent traffic, not this session's own messages. isMeta=="true" entries
# (e.g. the skill-launch "Base directory for this skill: ..." injection, or
# "[Request interrupted by user]") are also type=="user" with non-tool_result
# content but are not something the human typed, so they are excluded too --
# counting one as a turn boundary would truncate the turn right past a
# SendMessage and make the guard below skip a session that is actually
# waiting on a reply.
last_turn_sent_message() {
  jq -s '
    [ .[] | select((.isSidechain != true) and (.type == "user" or .type == "assistant")) ] as $msgs
    | ( [ $msgs | to_entries[]
          | select(.value.type == "user" and (.value.isMeta != true))
          | select( (.value.message.content | type) == "string"
                    or ( (.value.message.content | type) == "array"
                         and ( [ .value.message.content[]?.type ] | any(. != "tool_result") ) ) )
          | .key ] | last // -1 ) as $start
    | [ $msgs[($start + 1):][]
        | select(.type == "assistant")
        | .message.content[]? | select(.type == "tool_use") | .name ]
    | any(. == "SendMessage")
  ' "$1"
}

in_list() { local x="$1"; shift; for e in "$@"; do [ "$e" = "$x" ] && return 0; done; return 1; }

# Candidates: live background sessions the roster reports as idle.
declare -a candidates=()
while IFS= read -r sid; do
  [ -n "$sid" ] || continue
  candidates+=("$sid")
done < <(jq -r '.[] | select(.kind == "background" and .status == "idle") | .sessionId' <<<"$roster")

declare -a shorts=()
for sid in "${candidates[@]}"; do shorts+=("${sid:0:8}"); done

# Stale job records: background roster entries with no `pid`, i.e. the process
# behind the job is already gone. `kind == "background" and pid == null`
# decides this -- `state` comes along only to be printed. Restricting to
# kind=="background" matters because an interactive entry can also lack a
# `pid`; ~/.claude/jobs/<id> is a background-job concept, not a general claude
# one, so a pid-less interactive entry is not a stale job record at all. These
# are reported, never acted on, so they are collected apart from the reap
# accumulators. Each entry is "<job-id>\t<config dir>\t<state>" -- the dir is
# carried because the job directory the report names lives under whichever config
# dir the entry came from, not necessarily the default one.
#
# The possibly-empty `state` is LAST in both the TSV and the entry. bash treats
# tab as IFS *whitespace*, so `read` collapses a run of them into one separator:
# an empty field in the middle would shift every field after it left, and the
# dir would silently be read as the state. A trailing one just leaves its
# variable empty, which is the intended reading.
declare -a stale=()
while IFS=$'\t' read -r job_id job_dir job_state; do
  [ -n "$job_id" ] || continue
  if [ "${#filters[@]}" -gt 0 ] && ! in_list "$job_id" "${filters[@]}"; then
    continue
  fi
  stale+=("$job_id"$'\t'"$job_dir"$'\t'"$job_state")
done < <(jq -r '.[] | select(.kind == "background" and .pid == null)
                    | [ ((.id // .sessionId // "") | .[0:8]), (.configDir // ""), (.state // "") ]
                    | @tsv' <<<"$roster")

declare -a stale_ids=()
for e in "${stale[@]}"; do stale_ids+=("${e%%$'\t'*}"); done

# Requested ids that are not candidates get a skip line, so a caller who named
# an id learns why nothing happened to it. An id that turned out to be a stale
# job record is left out: the stale section below already explains it, and
# "not a live idle background session" would be a misleading second answer.
if [ "${#filters[@]}" -gt 0 ]; then
  for f in "${filters[@]}"; do
    if [ "${#shorts[@]}" -gt 0 ] && in_list "$f" "${shorts[@]}"; then continue; fi
    if [ "${#stale_ids[@]}" -gt 0 ] && in_list "$f" "${stale_ids[@]}"; then continue; fi
    reap_skip "$f" "not a live idle background session"
  done
fi

now="$(date +%s)"

for sid in "${candidates[@]}"; do
  short="${sid:0:8}"
  if [ "${#filters[@]}" -gt 0 ] && ! in_list "$short" "${filters[@]}"; then
    continue
  fi

  row=""
  while IFS=$'\t' read -r q_id q_state q_created q_transcript; do
    if [ "$q_id" = "$sid" ]; then
      row="found"
      break
    fi
  done <<<"$queue"

  if [ -z "$row" ]; then
    reap_skip "$short" "no live claude-queue row (untracked, or already ended)"
    continue
  fi

  if [ "$q_state" != "idle_done" ]; then
    reap_skip "$short" "latest queue event is '$q_state', not idle_done"
    continue
  fi

  age=$(( now - q_created ))
  if [ "$age" -lt "$idle_seconds" ]; then
    reap_skip "$short" "idle for $(( age / 60 ))m, under the ${idle_minutes}m threshold"
    continue
  fi

  # Orphan: linked to a parent the roster no longer lists.
  orphan_note=""
  while IFS=$'\t' read -r l_child l_parent; do
    [ "$l_child" = "$short" ] || continue
    if [ -n "$l_parent" ] \
       && ! { [ "${#roster_sids[@]}" -gt 0 ] && in_list "$l_parent" "${roster_sids[@]}"; }; then
      orphan_note="; orphan: parent ${l_parent:0:8} gone"
    fi
    break
  done <<<"$links"

  # The pending-question check, skipped for an orphan: the delegator it would
  # be waiting on is gone, so no reply is coming.
  if [ -z "$orphan_note" ]; then
    # No transcript means the SendMessage check cannot run. Skip rather than
    # assume: an unverifiable session is indistinguishable from one holding a
    # pending question.
    if [ -z "$q_transcript" ] || [ ! -r "$q_transcript" ]; then
      reap_skip "$short" "no readable transcript to check for a pending question"
      continue
    fi
    if ! sent="$(last_turn_sent_message "$q_transcript" 2>/dev/null)"; then
      reap_skip "$short" "could not parse the transcript ($q_transcript)"
      continue
    fi
    if [ "$sent" != "false" ]; then
      reap_skip "$short" "last turn sent a SendMessage (likely awaiting a reply)"
      continue
    fi
  fi

  if [ "$dry_run" = 1 ]; then
    reap_ok "$short" "would stop (idle $(( age / 60 ))m${orphan_note})"
    continue
  fi
  if claude-stop-bg "$short"; then
    reap_ok "$short" "stopped (idle $(( age / 60 ))m${orphan_note})"
  else
    reap_skip "$short" "claude-stop-bg refused"
  fi
done

echo
label="reaped"
if [ "$dry_run" = 1 ]; then label="would reap"; fi
if [ "${#reaped[@]}" -gt 0 ]; then
  echo "$label (${#reaped[@]}):"
  for e in "${reaped[@]}"; do printf '  %s\n' "${e/$'\t'/  -- }"; done
else
  echo "$label (0): nothing"
fi
if [ "${#skipped[@]}" -gt 0 ]; then
  echo "skipped (${#skipped[@]}):"
  for e in "${skipped[@]}"; do printf '  %s\n' "${e/$'\t'/  -- }"; done
fi

# Third section, printed only when there is something in it: unlike reaped, an
# empty one carries no information, and this tool never touched these anyway.
# The removal command is text for the human to read; nothing here runs it.
if [ "${#stale[@]}" -gt 0 ]; then
  echo "stale job records (${#stale[@]}):"
  for e in "${stale[@]}"; do
    IFS=$'\t' read -r job_id job_dir job_state <<<"$e"
    if [ -n "$job_state" ]; then
      printf '  %s  no process (state: %s)\n' "$job_id" "$job_state"
    else
      printf '  %s  no process\n' "$job_id"
    fi
    printf '    → rm -rf %s/jobs/%s\n' "${job_dir:-$(cq_default_config_dir)}" "$job_id"
  done
fi
