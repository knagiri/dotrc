#!/usr/bin/env bash
set -euo pipefail

# gh-issue-file -- the single path an agent uses to open an issue in this repo.
#
# What it enforces that a bare `gh issue create` cannot:
#   1. Structure. `gh issue create --title X --body Y` never applies an issue
#      template (-T/--template is starting text for the interactive/editor
#      path), and YAML issue forms are unreachable non-interactively. So the
#      body is checked here, against the very same .github/ISSUE_TEMPLATE file
#      the web UI serves -- one source of truth, no second skeleton to drift.
#   2. Fixed labels. harness and bug are observations (label `observation`, no
#      status/*): duplicates are not refused. task keeps status/triage, the
#      human gate.
#   3. A denylist. Title, body and a --resolved-by URL are matched against the
#      gitignored .issue-denylist of $root's main working tree (fixed strings,
#      case-insensitive) and refused on a hit. Without a usable denylist (no
#      file, or no pattern in it), a filing from a repo other than $root's is
#      refused outright: it would reach a public repo with nobody reading it.
#      A denylist that exists but cannot be read refuses every filing.
#
# Each body gets `<!-- observed-session: <id> -->` appended (from
# $CLAUDE_CODE_SESSION_ID, omitted when unset) so repeated filings by one
# session can be counted once. The caller's file is never modified.
#
# Allowlist as `Bash(gh-issue-file *)`. No flag pass-through: labels are fixed
# and unknown flags are refused rather than handed to gh.
#
# Usage: gh-issue-file [--global] --kind <harness|bug|task> --title <title>
#                      --body-file <path> [--parent N] [--resolved-by <PR-URL>]
#        gh-issue-file [--global] --list-groups
#
# --parent N files the issue as a sub-issue of group #N; #N must be a group
# filed by the repo owner. --resolved-by files it and then closes it with a
# comment pointing at the PR that already fixed it; a PR in another repository
# is not named in the comment.
# --list-groups prints the repo owner's open groups as `#N<TAB>title`, one per
# line, to choose --parent from.
#
# --global files into the repo this script lives in (the dotfiles repo) instead
# of cwd's, so an agent working in an unrelated project can still open a harness
# issue where the harness lives. Without it, that agent has no filing path at
# all: cwd's repo has no .github/ISSUE_TEMPLATE/<kind>.md and the wrapper stops
# at exit 1. Same spelling, and the same intent, as claude-worktree --global.
#
# Exit:  0 created (or listed) / 1 bad input / 3 refused by the denylist, or no
#          usable denylist while filing from another repo
#        / 4 the issue WAS created but the --resolved-by follow-up (reading the
#          number, closing) failed: do not run again, it would file a duplicate
#        / 128 called outside a git repo without --global (git itself fails
#          `set -e` below)
#        / anything else: gh's own exit code from before the issue exists,
#          passed through unchanged by `set -e` (not rounded to 1). gh runs through gh_mise
#          (bin/lib/gh-mise.sh); `mise exec` propagates its child's status
#          unchanged. See dot/claude/rules/issue-workflow.md §2.

usage() {
  cat >&2 <<'EOF'
usage: gh-issue-file [--global] --kind <harness|bug|task> --title <title>
                     --body-file <path> [--parent N] [--resolved-by <PR-URL>]
       gh-issue-file [--global] --list-groups
EOF
  exit "${1:-1}"
}

kind=""; title=""; body_file=""; parent=""; resolved_by=""; file_global=0; list_groups=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)     usage 0 ;;
    --global)      file_global=1; shift ;;
    --list-groups) list_groups=1; shift ;;
    --kind)        [ $# -ge 2 ] || usage 1; kind="$2"; shift 2 ;;
    --title)       [ $# -ge 2 ] || usage 1; title="$2"; shift 2 ;;
    --body-file)   [ $# -ge 2 ] || usage 1; body_file="$2"; shift 2 ;;
    --parent)      [ $# -ge 2 ] || usage 1; parent="$2"; shift 2 ;;
    --resolved-by) [ $# -ge 2 ] || usage 1; resolved_by="$2"; shift 2 ;;
    *)
      # No pass-through: an unrecognised flag is a caller bug, not something to
      # forward to gh, where it could add labels or assignees behind our back.
      echo "gh-issue-file: unknown argument: $1" >&2
      usage 1 ;;
  esac
done

if [ "$list_groups" = 0 ]; then
  case "$kind" in
    harness|bug|task) ;;
    "") echo "gh-issue-file: --kind is required" >&2; usage 1 ;;
    *)  echo "gh-issue-file: --kind must be harness, bug or task (got: $kind)" >&2; exit 1 ;;
  esac
  [ -n "$title" ] || { echo "gh-issue-file: --title is required" >&2; usage 1; }
  [ -n "$body_file" ] || { echo "gh-issue-file: --body-file is required" >&2; usage 1; }
  [ -r "$body_file" ] || { echo "gh-issue-file: cannot read body file: $body_file" >&2; exit 1; }
  if [ -n "$parent" ] && [[ ! "$parent" =~ ^[0-9]+$ ]]; then
    echo "gh-issue-file: --parent must be an issue number (got: $parent)" >&2
    exit 1
  fi
  if [ -n "$resolved_by" ] && [[ ! "$resolved_by" =~ ^https://github\.com/[^/]+/[^/]+/pull/[0-9]+$ ]]; then
    echo "gh-issue-file: --resolved-by must be a GitHub PR URL (got: $resolved_by)" >&2
    exit 1
  fi
elif [ -n "$kind$title$body_file$parent$resolved_by" ]; then
  echo "gh-issue-file: --list-groups takes no other flag but --global" >&2
  usage 1
fi

# Every gh call goes through gh_mise so the repo's mise-provided env (GH_TOKEN)
# is loaded even in a non-interactive process; see bin/lib/gh-mise.sh.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/gh-mise.sh"

# One $root decides everything this wrapper does -- which template the body is
# checked against, which denylist applies, and which repo the issue is filed
# into -- so they can never drift apart. --global moves it to the repo holding
# this script (resolving any PATH symlink first), the same anchor
# claude-worktree --global uses.
if [ "$file_global" = 1 ]; then
  root="$(gh_mise_repo_root "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"  # global-root@dotrc
else
  root="$(git rev-parse --show-toplevel)"
fi
# gh_mise runs gh with $root as its cwd, which is what makes every call land in
# $root's repo rather than the caller's.
gh_mise_use "$root"

if [ "$list_groups" = 1 ]; then
  # Only the owner's groups: anyone can open an issue in a public repo, and a
  # title written by someone else is not something to put in front of an agent.
  owner="$(gh_mise repo view --json owner --jq .owner.login)"
  gh_mise issue list --label group --state open --author "$owner" --limit 200 \
    --json number,title --jq '.[] | "#\(.number)\t\(.title)"'
  exit 0
fi

template="$root/.github/ISSUE_TEMPLATE/$kind.md"
if [ ! -r "$template" ]; then
  echo "gh-issue-file: no template at $template" >&2
  echo "  This repo has no agent-task scaffolding. See docs/design/agent-issue-workflow.md." >&2
  [ "$file_global" = 1 ] || \
    echo "  To file a harness issue into the dotfiles repo instead, pass --global." >&2
  exit 1
fi

# Required headings = the `## ` lines of the template, minus its YAML front
# matter. Read at run time so the template stays the only place the skeleton is
# written down.
required_headings() {
  awk '
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---"   { in_fm = 0; next }
    in_fm                  { next }
    /^## /                 { sub(/[ \t]+$/, ""); print }
  ' "$1"
}

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

# Compare with trailing whitespace stripped on both sides, so a stray space at
# the end of a heading line in the body is not treated as a missing section.
# Written to a file and matched by a single grep: `sed | grep -q` would let
# grep exit at the first hit and sed die of SIGPIPE, which pipefail reports as
# a failure on a large body.
sed -e 's/[ \t]*$//' "$body_file" >"$tmpdir/body.norm"
missing=""
while IFS= read -r heading; do
  [ -n "$heading" ] || continue
  if ! grep -qxF "$heading" "$tmpdir/body.norm"; then
    missing="$missing$heading"$'\n'
  fi
done < <(required_headings "$template")

if [ -n "$missing" ]; then
  echo "gh-issue-file: body is missing required headings from $kind.md:" >&2
  printf '%s' "$missing" | sed 's/^/  /' >&2
  exit 1
fi

# --- denylist ---------------------------------------------------------------
# Repos are told apart by their common git dir, so a linked worktree of $root's
# repo counts as the same repo. Outside any checkout the caller is foreign.
common_dir() { git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true; }
caller_common="$(common_dir "$PWD")"
root_common="$(common_dir "$root")"

# The denylist is gitignored, so it exists only in the main working tree. When
# $root is a linked worktree, look there rather than in the worktree root.
deny_root="$root"
case "$root_common" in */.git) deny_root="${root_common%/.git}" ;; esac  # deny-root@dotrc
deny_file="$deny_root/.issue-denylist"

deny_active=0
if [ -e "$deny_file" ]; then
  # Present but unreadable is a refusal, not "no denylist": falling through
  # would let a same-repo filing skip the check.
  if [ ! -r "$deny_file" ]; then
    echo "gh-issue-file: cannot read $deny_file; not filed." >&2
    exit 3
  fi
  # Blank and whitespace-only lines are dropped, and surrounding whitespace is
  # trimmed: an empty pattern makes grep -F match every line, which would stop
  # every filing.
  deny_patterns() {
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -- "$deny_file"  # deny-blank@dotrc
  }
  deny_patterns >"$tmpdir/patterns" || { echo "gh-issue-file: cannot read $deny_file; not filed." >&2; exit 3; }
  # A file with no pattern checks nothing, so it counts as no denylist.
  [ ! -s "$tmpdir/patterns" ] || deny_active=1
fi

if [ "$deny_active" = 1 ]; then
  # Everything that will be published, in one file and one grep process: with
  # `{ ...; cat body; } | grep -q`, grep exits at its first hit, cat dies of
  # SIGPIPE on a large body, and pipefail turns a match into a "no match".
  { printf '%s\n' "$title"; cat -- "$body_file"; printf '\n%s\n' "$resolved_by"; } >"$tmpdir/subject"
  rc=0
  grep -qiF -f "$tmpdir/patterns" "$tmpdir/subject" || rc=$?  # deny-grep@dotrc
  case "$rc" in
    0)
      # The matched term is not echoed: the denylist's contents stay out of
      # transcripts and logs, same as they stay out of git.
      echo "gh-issue-file: title, body or PR URL matches $deny_file; not filed. Rewrite it without the specific name." >&2
      exit 3 ;;
    1) ;;
    *)
      # grep failed (2 or more): the answer is unknown, so refuse.
      echo "gh-issue-file: denylist check failed (grep exit $rc); not filed." >&2
      exit 3 ;;
  esac
elif [ -z "$caller_common" ] || [ "$caller_common" != "$root_common" ]; then
  echo "gh-issue-file: no usable $deny_file, and this filing comes from outside $root's repo; refusing." >&2
  echo "  Create the denylist first (see docs/design/agent-issue-workflow.md)." >&2
  exit 3
fi

# --- checks before create ---------------------------------------------------
if [ -n "$parent" ]; then
  # Only the owner's groups: anyone can open an issue in a public repo.
  owner="$(gh_mise repo view --json owner --jq .owner.login)"
  parent_line="$(gh_mise issue view "$parent" --json author,labels \
    --jq '"\(.author.login)\t\([.labels[].name] | join(","))"')"
  IFS=$'\t' read -r parent_author parent_labels <<<"$parent_line"
  if [ "$parent_author" != "$owner" ]; then
    echo "gh-issue-file: --parent #$parent was not filed by $owner; not filed." >&2
    exit 1
  fi
  case ",$parent_labels," in
    *,group,*) ;;
    *) echo "gh-issue-file: --parent #$parent is not a group; not filed." >&2; exit 1 ;;
  esac
fi

resolved_note=""
if [ -n "$resolved_by" ]; then
  nwo="$(gh_mise repo view --json nameWithOwner --jq .nameWithOwner)"
  pr_repo="${resolved_by#https://github.com/}"; pr_repo="${pr_repo%/pull/*}"
  # Only a PR of this repo is named in the public comment: a link into another
  # repository can disclose it.
  if [ "${pr_repo,,}" = "${nwo,,}" ]; then
    resolved_note="Resolved by $resolved_by"
  else
    resolved_note="Resolved by a PR in another repository"
  fi
fi

# --- create -----------------------------------------------------------------
# gh is handed this absolute copy, never the caller's path: gh runs with $root
# as its cwd (gh_mise), so a relative --body-file would be resolved against the
# repo root -- reading a different file, or none. The copy is read here, in the
# caller's cwd.
body="$tmpdir/body.md"
cp -- "$body_file" "$body"
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  printf '\n<!-- observed-session: %s -->\n' "$CLAUDE_CODE_SESSION_ID" >>"$body"
fi

# Labels are fixed here rather than accepted from the caller. For task,
# status/triage in particular is not the caller's to choose: promoting it to
# status/ready is the human gate (dot/claude/rules/issue-workflow.md).
#
# If these labels do not exist yet in the repo, gh fails right here. That is
# intentional -- the wrapper does not create labels (that would widen what this
# grant can do); run the one-time setup in
# docs/design/agent-issue-workflow.md first.
case "$kind" in
  task) labels=(--label agent-task --label kind/task --label status/triage) ;;
  *)    labels=(--label agent-task --label "kind/$kind" --label observation) ;;
esac
parent_args=()
[ -z "$parent" ] || parent_args=(--parent "$parent")

url="$(gh_mise issue create --title "$title" --body-file "$body" \
  "${labels[@]}" ${parent_args[@]+"${parent_args[@]}"})"
printf '%s\n' "$url"

if [ -n "$resolved_by" ]; then
  # From here the issue exists. A failure now exits 4, never gh's own code or 1,
  # so a caller that retries on failure cannot file the same issue twice.
  number="${url##*/}"
  if [[ ! "$number" =~ ^[0-9]+$ ]]; then
    echo "gh-issue-file: filed $url but cannot read its number; NOT closed. Do not run again." >&2
    exit 4
  fi
  gh_mise issue close "$number" --comment "$resolved_note" \
    || { echo "gh-issue-file: filed $url but closing it failed; NOT closed. Do not run again." >&2; exit 4; }
fi
