#!/usr/bin/env bash
set -euo pipefail

# gh-issue-group -- the guarded write path for observation groups and for
# closing finished tasks, in the issue repo (bin/lib/issue-repo.sh;
# dot/claude/rules/issue-workflow.md).
#
# Each subcommand does one fixed edit, so the grant can be allowlisted as
# `Bash(gh-issue-group *)` without handing out raw `gh issue edit`: there is no flag
# pass-through, and every target is read first and refused unless it carries the
# label the operation is for. That keeps the wrapper to the issues it exists
# for; who may write issues at all is settled by the issue repo being private.
#
# Usage:
#   gh-issue-group create --title <title> --body-file <path>
#       Open a group (labels agent-task, group). Prints its URL.
#   gh-issue-group attach <group> <observation>...
#       Add observations as sub-issues of <group>. A closed group is reopened.
#       An observation that already has a parent is refused (detach it first);
#       the check runs before any write. Labels on the group are not touched.
#   gh-issue-group detach <observation>
#       Remove the observation's parent.
#   gh-issue-group set-body <group> <path>
#       Replace the group's body.
#   gh-issue-group close <observation|group> [--not-planned]
#       Close as completed, or as not planned (expiry).
#   gh-issue-group reopen <group>
#   gh-issue-group mark <group> delegated|rejected|clear
#       Set the group's state: group/delegated and group/rejected are exclusive;
#       clear removes both.
#   gh-issue-group close-task <task>
#       Close a task as completed. Refused unless it carries both kind/task and
#       status/delegated.
#
# Exit: 0 done / 1 bad input or a target that fails its check (no write is
#       made) / 3 the issue repo is not configured (bin/lib/issue-repo.sh; no
#       gh call) / anything else: gh's own exit code (bin/lib/gh-mise.sh).

usage() {
  sed -n '/^# Usage:/,/^# Exit:/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^Exit:/d' >&2
  exit "${1:-1}"
}
die() { echo "gh-issue-group: $*" >&2; exit 1; }
num() { [[ "$1" =~ ^[0-9]+$ ]] || die "issue number must be numeric (got: $1)"; }

[ $# -ge 1 ] || usage 1
cmd="$1"; shift
case "$cmd" in
  -h|--help) usage 0 ;;
  create|attach|detach|set-body|close|reopen|mark|close-task) ;;
  *) die "unknown subcommand: $cmd" ;;
esac

# Validate the arguments fully before any gh call.
case "$cmd" in
  create)
    title=""; body_file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --title)     [ $# -ge 2 ] || usage 1; title="$2"; shift 2 ;;
        --body-file) [ $# -ge 2 ] || usage 1; body_file="$2"; shift 2 ;;
        *) die "unknown argument: $1" ;;
      esac
    done
    [ -n "$title" ] || die "--title is required"
    [ -r "$body_file" ] || die "cannot read body file: $body_file" ;;
  attach)
    [ $# -ge 2 ] || usage 1
    for n in "$@"; do num "$n"; done ;;
  detach|reopen|close-task)
    [ $# -eq 1 ] || usage 1; num "$1" ;;
  set-body)
    [ $# -eq 2 ] || usage 1; num "$1"
    [ -r "$2" ] || die "cannot read body file: $2" ;;
  close)
    { [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = --not-planned ]; }; } || usage 1
    num "$1" ;;
  mark)
    [ $# -eq 2 ] || usage 1; num "$1"
    case "$2" in delegated|rejected|clear) ;; *) die "mark state must be delegated, rejected or clear (got: $2)" ;; esac ;;
esac

# Every gh call goes through gh_mise so the repo's mise-provided env (GH_TOKEN)
# is loaded even in a non-interactive process; see bin/lib/gh-mise.sh.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=bin/lib/gh-mise.sh
. "$here/lib/gh-mise.sh"
# shellcheck source=bin/lib/issue-repo.sh
. "$here/lib/issue-repo.sh"
# gh runs in this script's repo, for its token; the target is always -R.
gh_mise_use "$(gh_mise_repo_root "$here")"
R=(-R "$ISSUE_REPO")

# view <issue> -- read <issue> into $state, $parent_of (its parent number or
# `none`) and $labels. The labels come last: a trailing empty field survives
# `read`, an empty middle one would collapse.
parent_of=""
view() {
  local line
  line="$(gh_mise issue view "${R[@]}" "$1" --json state,parent,labels \
    --jq '"\(.state)\t\(.parent.number? // "none")\t\([.labels[].name] | join(","))"')"
  IFS=$'\t' read -r state parent_of labels <<<"$line"
}
# check <issue> <label>... -- refuse unless <issue> carries one of the labels.
check() {
  local n="$1" l ok=0
  shift
  view "$n"
  for l in "$@"; do
    case ",$labels," in *",$l,"*) ok=1 ;; esac
  done
  [ "$ok" = 1 ] || die "#$n carries none of: $* (labels: ${labels:-none})"
}

case "$cmd" in
  create)
    # gh runs in the repo root (gh_mise), so hand it an absolute path.
    gh_mise issue create "${R[@]}" --title "$title" --body-file "$(realpath -- "$body_file")" \
      --label agent-task --label group ;;
  attach)
    group="$1"; shift
    # Check every observation before the first write, so a bad one leaves the
    # group untouched.
    for o in "$@"; do
      check "$o" observation
      [ "$parent_of" = none ] || die "#$o already has parent #$parent_of; detach it first"
    done
    check "$group" group
    [ "$state" != CLOSED ] || gh_mise issue reopen "${R[@]}" "$group"
    obs="$(IFS=,; printf '%s' "$*")"
    gh_mise issue edit "${R[@]}" "$group" --add-sub-issue "$obs" ;;
  detach)
    check "$1" observation
    gh_mise issue edit "${R[@]}" "$1" --remove-parent ;;
  set-body)
    check "$1" group
    gh_mise issue edit "${R[@]}" "$1" --body-file "$(realpath -- "$2")" ;;
  close)
    check "$1" observation group
    if [ "${2:-}" = --not-planned ]; then
      gh_mise issue close "${R[@]}" "$1" --reason "not planned"
    else
      gh_mise issue close "${R[@]}" "$1"
    fi ;;
  reopen)
    check "$1" group
    gh_mise issue reopen "${R[@]}" "$1" ;;
  mark)
    check "$1" group
    case "$2" in
      delegated) gh_mise issue edit "${R[@]}" "$1" --add-label group/delegated --remove-label group/rejected ;;
      rejected)  gh_mise issue edit "${R[@]}" "$1" --add-label group/rejected --remove-label group/delegated ;;
      clear)     gh_mise issue edit "${R[@]}" "$1" --remove-label group/delegated --remove-label group/rejected ;;
    esac ;;
  close-task)
    # Both labels, not either: only a task someone started may be closed here.
    view "$1"
    case ",$labels," in *,kind/task,*) ;; *) die "#$1 is not a kind/task issue (labels: ${labels:-none})" ;; esac
    case ",$labels," in *,status/delegated,*) ;; *) die "#$1 is not status/delegated (labels: ${labels:-none})" ;; esac  # task-delegated@dotrc
    gh_mise issue close "${R[@]}" "$1" ;;
esac
