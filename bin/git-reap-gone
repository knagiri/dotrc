#!/usr/bin/env bash
set -euo pipefail

# git-reap-gone [--no-fetch] [<branch>...] -- conservatively reap [gone] branches
# (and their worktrees) left behind by merged, delegated work.
#
# A local branch becomes [gone] when its tracked upstream is deleted on the
# remote (typically the remote branch is removed on merge, then `git fetch
# --prune` marks the local copy [gone]). That is the authoritative "this work is
# done" signal we trigger on -- completion is never inferred, only observed.
#
# MUST RUN WITH THE INTEGRATION BASE CHECKED OUT. The base is origin/HEAD (e.g.
# origin/main); its local counterpart is that name with the remote prefix
# stripped (main). If HEAD is not on the local base branch the script exits 1
# without touching anything, and says which branch to check out -- or, if that
# branch is already checked out in another worktree (the linked-worktree case:
# `git switch` there would be refused, git forbids the same branch in two
# worktrees at once), points at that worktree's path instead. That exit 1 is
# not a "skip" -- it is a usage error, like an unknown flag, and does not
# contradict the best-effort exit 0 below.
#
# The reason is that `git branch -d` has exactly two yardsticks: the branch's
# upstream if it has one, else HEAD. There is no way to pass it a base. A [gone]
# branch by definition has no resolvable upstream, so `git branch -d` ALWAYS
# falls back to HEAD here -- while the gate below measures against origin/HEAD.
# If those two disagree (a stale local main is the common case), the gate passes
# and the deletion is refused. Pinning HEAD to the base makes them the same
# question. With HEAD pinned, the script then fast-forwards the local base to
# origin/HEAD so a stale checkout stops mattering; a failed fast-forward is only
# warned about (the gates below stay sound either way -- the worst outcome is
# extra skips, never a wrong deletion).
#
# For each [gone] branch (optionally filtered to the names given as arguments):
#   * guard: no unintegrated commits. The integration base is origin/HEAD (e.g.
#     origin/main). If `git rev-list --count <base>..<branch>` is non-zero the
#     branch carries local-only commits and is SKIPPED (never lost).
#   * preflight: the branch must be reachable from HEAD -- the very test
#     `git branch -d` will apply. Checked BEFORE the worktree is removed, so a
#     branch that would be refused never leaves a half-reaped state behind
#     (worktree gone, branch still there).
#   * if a worktree is checked out on the branch: it must be clean
#     (`git status --porcelain` empty), and it must not be the worktree this
#     script runs in. Then `git worktree remove` (NO --force) + `git branch -d`.
#   * if no worktree is attached (bare branch): just `git branch -d` after the
#     guard.
#
# Anything that fails a check is SKIPPED and reported with the blocking reason.
# Deletion is ALWAYS the safe form (`git worktree remove` without --force,
# `git branch -d` not -D); this script never escalates to a force delete. If git
# itself refuses a deletion, that branch is reported skipped, not forced.
#
# Manual, best-effort: exits 0 even when branches are skipped. It sweeps every
# [gone] branch by default so it can later be dropped into cron/loop unchanged.
#
# Known limits (deliberately not handled):
#   * only "origin" is understood as the remote name. Repos whose default remote
#     is named otherwise fall through to the local-branch fallback below.
#   * if origin/HEAD and origin/main are both unresolvable the base falls back to
#     the LOCAL main, which can itself be stale -- the gate is then measured
#     against a stale base. Nothing is deleted that HEAD cannot reach, so this
#     stays conservative, but it can reap a branch merged only into stale main.
#   * origin/HEAD is recorded at clone time and can go stale if the remote's
#     default branch is renamed. Refreshing it (`git remote set-head --auto`)
#     has a network side effect, so it is left to the operator.
#
# Usage:
#   git-reap-gone [--no-fetch] [<branch>...]
#
#   --no-fetch   skip the leading `git fetch --prune` (assume [gone] state is
#                already current, e.g. the caller fetched)
#   <branch>...  restrict reaping to these branch names (still fully gated)

usage() {
  awk '/^#!/ {next} /^#/ {sub(/^# ?/, ""); print; seen=1; next} seen {exit}' "$0"
  exit "${1:-1}"
}

do_fetch=1
declare -a filters=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage 0 ;;
    --no-fetch) do_fetch=0; shift ;;
    --) shift; while [ $# -gt 0 ]; do filters+=("$1"); shift; done ;;
    -*) echo "git-reap-gone: unknown flag: $1" >&2; usage 1 ;;
    *) filters+=("$1"); shift ;;
  esac
done

# Report accumulators. Each entry is "<branch>\t<detail>".
declare -a reaped=()
declare -a skipped=()
declare -a warnings=()

reap_ok()  { reaped+=("$1"$'\t'"$2"); }
reap_skip() { skipped+=("$1"$'\t'"$2"); }
warn() { warnings+=("$1"); echo "git-reap-gone: warning: $1" >&2; }

# One-line-ify captured git stderr so it fits the "<branch> -- <detail>" report.
oneline() { local s="$1"; s="${s//$'\n'/ }"; printf '%s' "$s"; }

if [ "$do_fetch" = 1 ]; then
  echo "git-reap-gone: fetching (git fetch --prune)..." >&2
  git fetch --prune
fi

# Integration base: the branch merged work lands on. Prefer the remote's default
# (origin/HEAD, e.g. origin/main); fall back to origin/main then main. Empty if
# none can be resolved -- then every branch is skipped rather than guessed.
base=""
if b="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)" && [ "$b" != "origin/HEAD" ]; then
  base="$b"
elif git rev-parse --verify --quiet origin/main >/dev/null; then
  base="origin/main"
elif git rev-parse --verify --quiet main >/dev/null; then
  base="main"
fi

# The LOCAL counterpart of the base -- what `git branch -d` sees through HEAD.
# Strip the literal "origin/" prefix rather than the last path component: the
# base is either "origin/<name>" or an already-local name, and "<name>" may well
# contain slashes (origin/release/2.0).
base_local="${base#origin/}"

# Map branch name -> worktree path from `git worktree list --porcelain`. Blocks
# are separated by blank lines; a "branch refs/heads/<name>" line ties the
# preceding "worktree <path>" line to a branch (detached worktrees have none).
# Built BEFORE the HEAD check below so that check can tell whether base_local is
# already checked out elsewhere (a linked worktree cannot `git switch` to it).
declare -A wt_of=()
cur_wt=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) cur_wt="${line#worktree }" ;;
    "branch refs/heads/"*) wt_of["${line#branch refs/heads/}"]="$cur_wt" ;;
    "") cur_wt="" ;;
  esac
done < <(git worktree list --porcelain)

# The worktree this script is invoked from -- never remove it.
self_wt="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [ -n "$base" ]; then
  # (A) HEAD must be the local base. Detached HEAD has no branch name and is
  # therefore a mismatch too. Bail before touching anything.
  head_branch="$(git symbolic-ref --short -q HEAD || true)"
  if [ "$head_branch" != "$base_local" ]; then
    echo "git-reap-gone: HEAD is on '${head_branch:-(detached)}' but must be on '$base_local'." >&2
    echo "git-reap-gone: \`git branch -d\` measures [gone] branches against HEAD, so reaping" >&2
    echo "git-reap-gone: from anywhere else disagrees with this script's gate." >&2
    base_wt="${wt_of[$base_local]:-}"
    if [ -n "$base_wt" ] && [ "$base_wt" != "$self_wt" ]; then
      # base_local is already checked out in another worktree (worktree-scope.md
      # §7's primary caller: an agent cleaning up from inside the very linked
      # worktree it was delegated into). `git switch $base_local` here would fail
      # with "fatal: '$base_local' is already used by worktree at ...", so point
      # at that checkout instead of issuing advice the caller cannot follow.
      echo "git-reap-gone: '$base_local' is already checked out at '$base_wt' -- run it from there." >&2
    else
      echo "git-reap-gone: run \`git switch $base_local\` and retry." >&2
    fi
    exit 1
  fi

  # (B) With HEAD pinned to the base, catch it up to the remote so a stale local
  # base stops causing spurious refusals. Only meaningful when the base is a
  # remote-tracking ref. Never fatal: the gates stay sound without it.
  if [ "$base_local" != "$base" ]; then
    if ! ff_err="$(git merge --ff-only "$base" 2>&1 >/dev/null)"; then
      warn "could not fast-forward $base_local to $base: $(oneline "$ff_err")"
      warn "continuing with a stale $base_local -- branches it cannot reach will be skipped"
    fi
  fi
fi

# Collect [gone] local branches. `%(upstream:track)` is literally "[gone]" when
# the tracked upstream was pruned.
declare -a gone=()
while IFS=' ' read -r branch track; do
  [ "$track" = "[gone]" ] || continue
  # Never touch the integration base itself, whatever it is called.
  if [ -n "$base_local" ] && [ "$branch" = "$base_local" ]; then continue; fi
  gone+=("$branch")
done < <(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/)

# If explicit branches were requested, intersect (skip-report the ones asked for
# that are not actually [gone], so the caller learns why nothing happened).
in_list() { local x="$1"; shift; for e in "$@"; do [ "$e" = "$x" ] && return 0; done; return 1; }

if [ "${#filters[@]}" -gt 0 ]; then
  for f in "${filters[@]}"; do
    if ! in_list "$f" "${gone[@]}"; then
      if [ -n "$base_local" ] && [ "$f" = "$base_local" ]; then
        reap_skip "$f" "protected branch: the integration base is never reaped"
      else
        reap_skip "$f" "not a [gone] branch (skipped)"
      fi
    fi
  done
fi

for branch in "${gone[@]}"; do
  if [ "${#filters[@]}" -gt 0 ] && ! in_list "$branch" "${filters[@]}"; then
    continue
  fi

  # Guard: no unintegrated (local-only) commits relative to the integration base.
  if [ -z "$base" ]; then
    reap_skip "$branch" "cannot resolve integration base (origin/HEAD, origin/main, main)"
    continue
  fi
  if ! ahead="$(git rev-list --count "$base..$branch" 2>/dev/null)"; then
    reap_skip "$branch" "git rev-list $base..$branch failed; cannot judge integration"
    continue
  fi
  if [ "$ahead" != 0 ]; then
    reap_skip "$branch" "$ahead unintegrated commit(s) ahead of $base"
    continue
  fi

  # Preflight: exactly the test `git branch -d` will run (a [gone] branch has no
  # upstream left, so git falls back to HEAD). Checked here, BEFORE the worktree
  # is removed, so a refusal can never leave a half-reaped branch behind.
  if ! git merge-base --is-ancestor "$branch" HEAD; then
    reap_skip "$branch" "not reachable from HEAD ($base_local); git branch -d would refuse"
    continue
  fi

  wt="${wt_of[$branch]:-}"
  if [ -n "$wt" ]; then
    if [ "$wt" = "$self_wt" ]; then
      reap_skip "$branch" "checked out in the current worktree ($wt)"
      continue
    fi
    # A worktree whose directory was removed by hand is still registered. Detect
    # it explicitly: `git -C <gone dir> status` fails, and its empty output would
    # otherwise read as "clean" and lead to a misleading "remove refused".
    if [ ! -d "$wt" ]; then
      reap_skip "$branch" "worktree directory is missing ($wt); run \`git worktree prune\` first"
      continue
    fi
    if [ -n "$(git -C "$wt" status --porcelain)" ]; then
      reap_skip "$branch" "worktree not clean ($wt)"
      continue
    fi
    if ! git worktree remove "$wt"; then
      reap_skip "$branch" "git worktree remove refused ($wt)"
      continue
    fi
  fi

  if ! del_err="$(git branch -d "$branch" 2>&1 >/dev/null)"; then
    reap_skip "$branch" "${wt:+worktree ALREADY REMOVED; }git branch -d refused: $(oneline "$del_err")"
    continue
  fi
  reap_ok "$branch" "${wt:+worktree removed; }branch deleted"
done

echo
if [ "${#reaped[@]}" -gt 0 ]; then
  echo "reaped (${#reaped[@]}):"
  for e in "${reaped[@]}"; do printf '  %s\n' "${e/$'\t'/  -- }"; done
else
  echo "reaped (0): nothing"
fi
if [ "${#skipped[@]}" -gt 0 ]; then
  echo "skipped (${#skipped[@]}):"
  for e in "${skipped[@]}"; do printf '  %s\n' "${e/$'\t'/  -- }"; done
fi
if [ "${#warnings[@]}" -gt 0 ]; then
  echo "warnings (${#warnings[@]}):"
  for e in "${warnings[@]}"; do printf '  %s\n' "$e"; done
fi
