#!/usr/bin/env bash
set -euo pipefail

# gh-merge-when-green <PR#> <SHA> -- once every check of the PR passes while its
#   head is <SHA>, merge it with administrator privileges, which bypasses
#   required approvals and required checks:
#   `gh pr merge <PR> -R <OWNER/NAME> --admin --merge --match-head-commit <SHA>`.
# gh-merge-when-green --enabled -- exit 0 if the repo of the cwd is allowed for
#   that merge, 4 if not, 3 if the setting is unusable. Reads only.
#
# These two forms are all it accepts: <PR#> is a number, <SHA> 40 lower-case
# hex digits, and no option is passed through to gh. This wrapper is the only
# allowlisted path to `gh pr merge --admin`, and it reaches it only after every
# gate below has passed, in this order:
#
#   1. repo allowlist: the cwd's repo (`gh repo view`) is listed in
#      ADMIN_MERGE_REPOS, a whitespace-separated list of OWNER/NAME read from
#      the dotrc config FILE only (bin/lib/dotrc-config.sh). Unlike other dotrc
#      settings, an ADMIN_MERGE_REPOS in the environment is ignored: a caller
#      must not be able to name the repos it may bypass-merge. Unset, empty,
#      unreadable, or any element not of that form -> exit 3.
#   2. PR gate: the PR's author is the token's own login (`gh api user`), the
#      head is not from a fork (isCrossRepository false), the base is the repo's
#      default branch, and 1 to 99 files changed.
#   3. the PR head is <SHA>.
#   4. path allowlist: every changed path -- both sides of a rename, deleted
#      files included -- is allowed by the repo's path list (see below).
#   5. no unresolved review thread was started by a human (its first comment's
#      author is not a Bot), and no human's latest opinionated review is
#      CHANGES_REQUESTED (--admin bypasses required approvals, so a review that
#      has no thread would otherwise be bypassed), checked here and again right
#      before merging.
#   6. every check on the PR passes (see "CI wait").
#
# gh: every call is a plain `gh` with the hosts.yml login -- not bin/lib/
# gh-mise.sh, whose `mise exec` would let a checkout's mise config inject
# GH_REPO / GH_TOKEN -- and every GH_* / GITHUB_* token or selector in the
# environment is dropped first. The repo is resolved once from the cwd and then
# pinned with -R (or spelled out in the API path) on every later call.
#
# Changed files come from the REST endpoint repos/<nwo>/compare/<B>...<SHA>
# (per_page=100), where <B> is the base branch's commit resolved through
# branches/<base> (a bare name would also resolve a tag of the same name), read
# only after the head is confirmed to be <SHA>: the list is
# pinned to that commit, so a head that moves and comes back (A -> B -> A)
# cannot make the list of one commit be judged for another. `gh pr view --json
# files` carries no previous path for a rename (measured with gh 2.105.0: a
# RENAMED entry has only path, additions, deletions, changeType), while the
# REST entry has previous_filename. One page of 100 is read; a full page is
# refused rather than paginated, so a path cut off by a page boundary can never
# pass unchecked (compare itself caps files at 300, beyond that limit).
#
# Path list: ${XDG_CONFIG_HOME:-$HOME/.config}/dotrc/admin-merge-paths/OWNER/NAME,
# spelled as in ADMIN_MERGE_REPOS. It lives next to the dotrc config, outside
# any checkout, so nothing a PR or a checkout contains can change it. Missing,
# unreadable, or without a single pattern line -> nothing is merged (exit 4):
# empty is the intended initial state, not a misconfiguration.
#
# Its format and meaning are exactly .gitignore's, because git evaluates it: the
# list becomes the info/exclude of an empty scratch repo, and the changed paths
# are fed to `git check-ignore --no-index --stdin -z -v -n`. "Ignored" reads as
# "may be merged"; a path whose last matching pattern is a negation (`!...`)
# or that matches nothing is refused. In allowlist terms, gitignore's limit on
# re-including reads: once `dir/` is allowed, nothing beneath it can be refused
# again with `!` (`dir/` + `!dir/secret` still allows dir/secret); write
# `dir/*` + `!dir/secret` to carve a path out. The scratch git runs under
# `env -i` with GIT_CONFIG_NOSYSTEM=1, GIT_CONFIG_GLOBAL=/dev/null,
# core.excludesFile=/dev/null and core.ignoreCase=false, so no config of the
# caller's environment, user or system takes part.
#
# Parent directories with --no-index: the paths do not exist in the scratch
# repo, yet a directory pattern still matches what lies beneath it, so each
# changed path is fed as is, without its ancestors. Measured with git 2.56.1:
#   $ printf 'docs/\n' >.git/info/exclude
#   $ printf 'docs/a/b.txt\nx/docs/c.txt\ndocs\n' \
#       | git -c core.excludesFile=/dev/null check-ignore --no-index --stdin -v -n
#   .git/info/exclude:1:docs/	docs/a/b.txt
#   .git/info/exclude:1:docs/	x/docs/c.txt
#   ::	docs
# test/gh-merge-when-green.test.sh keeps this behaviour pinned.
#
# Never allowed, whatever the list says: anything under the root `.github/`
# (a PR could rewrite the CI that gates it) and anything under a `.claude/`
# directory at any depth (Claude Code permission grants), both compared
# case-insensitively. Other places that grant permissions in a given repo are
# for its path list to leave out.
#
# CI wait: wait GH_MERGE_WHEN_GREEN_INITIAL_DELAY seconds (default 30), then
# poll every GH_MERGE_WHEN_GREEN_INTERVAL (30). Each poll re-reads the head
# (moved off <SHA> -> 5) and the base (changed -> 4), then reads
# `gh pr checks <PR> --json name,bucket,state`, judged by its `bucket`s, not
# its exit code (with --json, gh exits 0 even when a check failed):
#   - any fail / cancel -> 6
#   - any pending (or an unknown bucket) -> keep waiting
#   - only pass / skipping -> complete; merge once complete has been seen on two
#     polls in a row, so a workflow created shortly after the others is still
#     waited for
# Every check counts, required or not. No checks at all is not a pass: when
# none have appeared GH_MERGE_WHEN_GREEN_NO_CHECKS_GRACE (180) seconds after the
# start -> 7. Past GH_MERGE_WHEN_GREEN_TIMEOUT (3600) seconds -> 8. With no
# checks gh prints "no checks reported on the '<branch>' branch" and exits 1
# even with --json (measured with gh 2.105.0); that reads as zero checks.
# `gh pr checks` reads check runs, which a fine-grained PAT has no permission
# for, so with such a token every run ends in 9 ("Resource not accessible",
# HTTP 403) and a host whose hosts.yml token is fine-grained never merges this
# way; a classic or OAuth token can read them.
#
# Limits: --admin bypasses required checks too, so a required workflow whose run
# is created later than two polls after the others finished is not waited for.
# The judgement gates (scope, tests, no design decision) are reported by the
# caller and not verified here.
#
# Exit codes:
#   0  merged (--enabled: the repo is allowed)
#   1  bad arguments or environment knobs, an unexpected gh failure or output
#   3  ADMIN_MERGE_REPOS is unusable (unset, malformed, config unreadable)
#   4  a gate refused: repo not allowed, author is not the token's login, fork,
#      base is not (or stopped being) the default branch, no or 100+ changed
#      files, a path outside the list or always refused, the list is missing /
#      empty / unreadable or cannot be evaluated, an unresolved thread started
#      by a human, a human's CHANGES_REQUESTED review (or more than 100
#      threads / reviews to check)
#   5  the head is not <SHA>, or moved while the checks were waited on
#   6  a check failed or was cancelled
#   7  no check appeared within the grace period
#   8  timed out waiting for checks
#   9  checks are unreadable (permission)
#   10 `gh pr merge` itself failed (including a --match-head-commit mismatch)
# The reason is printed to stderr in one line.
#
# Requires jq (see bin/list-install.sh).
#
# Usage: gh-merge-when-green <PR-number> <head-SHA>
#        gh-merge-when-green --enabled

me=gh-merge-when-green
die() { echo "$me: $2" >&2; exit "$1"; }
usage() {
  echo "usage: $me <PR-number> <head-SHA>" >&2
  echo "       $me --enabled" >&2
  exit "${1:-1}"
}

enabled_only=0
case "${1:-}" in
  -h|--help) [ $# -eq 1 ] || usage 1; usage 0 ;;
  --enabled) [ $# -eq 1 ] || usage 1; enabled_only=1 ;;
  *)
    [ $# -eq 2 ] || usage 1
    pr="$1"; sha="$2"
    [[ "$pr" =~ ^[0-9]+$ ]] || die 1 "PR number must be numeric (got: $pr)"
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die 1 "SHA must be 40 lower-case hex digits (got: $sha)"
    ;;
esac

# Which repo and token gh uses must not come from the caller: drop every gh /
# GitHub token and selector (GH_REPO, GH_HOST, GH_TOKEN, GH_CONFIG_DIR, ...),
# and git's repo selectors, which `gh repo view` reads through git. This
# wrapper's own GH_MERGE_WHEN_GREEN_* knobs stay.
for v in $(compgen -v GH_) $(compgen -v GITHUB_); do
  case "$v" in GH_MERGE_WHEN_GREEN_*) ;; *) unset "$v" ;; esac
done
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_PREFIX GIT_CEILING_DIRECTORIES

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=bin/lib/dotrc-config.sh
. "$here/lib/dotrc-config.sh"

# --- 1. repo allowlist -------------------------------------------------------
# dotrc_config prefers a non-empty environment variable; this key is read from
# the file only.
unset ADMIN_MERGE_REPOS
repos_raw="$(dotrc_config ADMIN_MERGE_REPOS)" || exit 3
read -r -a allowed_repos <<<"$repos_raw"
[ "${#allowed_repos[@]}" -gt 0 ] || die 3 "ADMIN_MERGE_REPOS is empty"
for r in "${allowed_repos[@]}"; do
  [[ "$r" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
    || die 3 "ADMIN_MERGE_REPOS must be whitespace-separated OWNER/NAME (got: $r)"
  case "/$r/" in */./*|*/../*) die 3 "ADMIN_MERGE_REPOS has a . or .. component (got: $r)" ;; esac
done

repo_out="$(gh repo view --json nameWithOwner,defaultBranchRef \
  --jq '.nameWithOwner, (.defaultBranchRef.name // "")')" \
  || die 1 "gh repo view failed"
{ read -r nwo; read -r default_branch; } <<<"$repo_out" || true
[ -n "${nwo:-}" ] || die 1 "gh repo view returned no repository"

listed=""
for r in "${allowed_repos[@]}"; do
  # GitHub owner and repo names are case-insensitive.
  [ "${r,,}" = "${nwo,,}" ] && listed="$r"
done
[ -n "$listed" ] || die 4 "$nwo is not in ADMIN_MERGE_REPOS"
if [ "$enabled_only" -eq 1 ]; then
  echo "$me: $nwo is in ADMIN_MERGE_REPOS" >&2
  exit 0
fi
owner="${nwo%%/*}"; name="${nwo#*/}"

# --- 2. PR gate --------------------------------------------------------------
me_login="$(gh api user --jq .login)" || die 1 "gh api user failed"
[ -n "$me_login" ] || die 1 "gh api user returned no login"

pr_out="$(gh pr view "$pr" -R "$nwo" --json author,isCrossRepository,baseRefName,headRefOid \
  --jq '(.author.login // ""), (.isCrossRepository | tostring), (.baseRefName // ""), (.headRefOid // "")')" \
  || die 1 "gh pr view #$pr failed"
{ read -r author; read -r cross; read -r base; read -r head; } <<<"$pr_out" || true

[ "$author" = "$me_login" ] || die 4 "#$pr is by '$author', not by the token's login $me_login"
[ "$cross" = false ] || die 4 "#$pr comes from a fork (isCrossRepository: $cross)"
[ -n "$default_branch" ] && [ "$base" = "$default_branch" ] \
  || die 4 "#$pr targets '$base', not the default branch '${default_branch:-(unknown)}'"

# --- 3. head -----------------------------------------------------------------
[ "$head" = "$sha" ] || die 5 "#$pr head is $head, not $sha"

# The base is resolved to a commit through the branches endpoint first: given a
# bare name, compare would resolve a tag of the same name as well, which
# anyone who can push could point elsewhere.
base_sha="$(gh api "repos/$nwo/branches/$base" --jq .commit.sha)" \
  || die 1 "gh api branches/$base failed"
[[ "$base_sha" =~ ^[0-9a-f]{40}$ ]] || die 1 "unexpected branches/$base response: $base_sha"
files_json="$(gh api "repos/$nwo/compare/$base_sha...$sha?per_page=100")" \
  || die 1 "gh api compare/$base_sha...$sha failed"
nfiles="$(jq 'if (.files | type) == "array" then .files | length else error("no files array") end' <<<"$files_json")" \
  || die 1 "unexpected compare/$base_sha...$sha response"
[ "$nfiles" -lt 100 ] || die 4 "#$pr changes 100 or more files; refusing to judge a truncated list"
[ "$nfiles" -gt 0 ] || die 4 "#$pr lists no changed files"

# --- 4. path allowlist -------------------------------------------------------
paths_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotrc/admin-merge-paths/$listed"
[ -f "$paths_file" ] || die 4 "no path list at $paths_file; nothing is merged"
[ -r "$paths_file" ] || die 4 "cannot read $paths_file"
grep -qvE '^[[:space:]]*(#.*)?$' "$paths_file" 2>/dev/null \
  || die 4 "$paths_file has no patterns; nothing is merged"

scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
# Both sides of a rename; NUL-separated so any byte in a path survives.
jq -j '.files[] | (.filename, "\u0000"), (.previous_filename // empty | (., "\u0000"))' \
  <<<"$files_json" >"$scratch/paths" || die 1 "unexpected compare/$base_sha...$sha response"

while IFS= read -r -d '' p; do
  case "/${p,,}/" in
    /.github/*) die 4 "$p is under .github/, which is never merged this way" ;;
    */.claude/*) die 4 "$p is under .claude/, which is never merged this way" ;;
  esac
done <"$scratch/paths"

# Runs git with nothing of the caller's environment or config taking part.
scratch_git() {
  env -i PATH="$PATH" HOME="$scratch" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git -c core.excludesFile=/dev/null -c core.ignoreCase=false "$@"
}
scratch_git init -q "$scratch/repo" || die 4 "git init failed in the scratch dir"
cp "$paths_file" "$scratch/repo/.git/info/exclude" || die 4 "cannot read $paths_file"

rc=0
(cd "$scratch/repo" && scratch_git check-ignore --no-index --stdin -z -v -n) \
  <"$scratch/paths" >"$scratch/verdict" || rc=$?
# 0: some path matched, 1: none did; anything else is git failing.
[ "$rc" -le 1 ] || die 4 "git check-ignore failed ($rc); cannot judge the paths"

# -z -v -n prints four fields per path: source, line number, pattern, path.
checked=0
while IFS= read -r -d '' src && IFS= read -r -d '' _line \
  && IFS= read -r -d '' pat && IFS= read -r -d '' p; do
  checked=$((checked + 1))
  if [ -z "$src" ] || [ -z "$pat" ]; then
    die 4 "$p is not in the path list $paths_file"
  fi
  case "$pat" in
    '!'*) die 4 "$p is excluded by '$pat' in $paths_file" ;;
  esac
done <"$scratch/verdict"
expected="$(tr -cd '\0' <"$scratch/paths" | wc -c)"
[ "$checked" -eq "$expected" ] \
  || die 4 "git check-ignore judged $checked of $expected paths; refusing"

# --- 5. human threads and reviews --------------------------------------------
# Prints "<unresolved threads whose first comment is not by a Bot> <latest
# CHANGES_REQUESTED reviews not by a Bot>" (a deleted author counts as human),
# or "more 0" when either list needs a second page: refused, not paginated.
human_threads() {
  local out
  # shellcheck disable=SC2016  # $owner etc. are GraphQL variables
  out="$(gh api graphql \
    -f query='query($owner:String!,$name:String!,$pr:Int!){
      repository(owner:$owner,name:$name){ pullRequest(number:$pr){
        reviewThreads(first:100){ pageInfo{ hasNextPage }
          nodes{ isResolved comments(first:1){ nodes{ author{ __typename } } } } }
        latestOpinionatedReviews(first:100){ pageInfo{ hasNextPage }
          nodes{ state author{ __typename } } } } } }' \
    -f owner="$owner" -f name="$name" -F pr="$pr")" \
    || die 1 "gh api graphql (review threads of #$pr) failed"
  jq -er '.data.repository.pullRequest as $p
      | if $p.reviewThreads.pageInfo.hasNextPage
           or ($p.latestOpinionatedReviews.pageInfo.hasNextPage // false) then "more 0"
        else ([$p.reviewThreads.nodes[] | select(.isResolved | not)
               | select((.comments.nodes[0].author.__typename // "") != "Bot")] | length) as $t
             | ([$p.latestOpinionatedReviews.nodes[] | select(.state == "CHANGES_REQUESTED")
                 | select((.author.__typename // "") != "Bot")] | length) as $r
             | "\($t) \($r)"
        end' <<<"$out" \
    || die 1 "unexpected review threads response for #$pr"
}
check_threads() {
  local n r
  read -r n r <<<"$(human_threads)"
  [ "$n" != more ] || die 4 "#$pr has more than 100 review threads or reviews; refusing to judge a truncated list"
  [ "$n" -eq 0 ] || die 4 "#$pr has $n unresolved review thread(s) started by a human"
  [ "$r" -eq 0 ] || die 4 "#$pr has $r CHANGES_REQUESTED review(s) by a human"
}
check_threads

# --- 6. CI wait --------------------------------------------------------------
knob() {  # knob <name> <default> -- a non-negative integer from the environment
  local v="${!1:-$2}"
  [[ "$v" =~ ^[0-9]+$ ]] || die 1 "$1 must be a non-negative integer (got: $v)"
  printf '%s\n' "$v"
}
initial_s="$(knob GH_MERGE_WHEN_GREEN_INITIAL_DELAY 30)"
interval_s="$(knob GH_MERGE_WHEN_GREEN_INTERVAL 30)"
timeout_s="$(knob GH_MERGE_WHEN_GREEN_TIMEOUT 3600)"
grace_s="$(knob GH_MERGE_WHEN_GREEN_NO_CHECKS_GRACE 180)"

started=$(date -u +%s)
sleep "$initial_s"
complete_streak=0
while :; do
  now_out="$(gh pr view "$pr" -R "$nwo" --json headRefOid,baseRefName \
    --jq '(.headRefOid // ""), (.baseRefName // "")')" \
    || die 1 "gh pr view #$pr failed while waiting"
  { read -r head; read -r base; } <<<"$now_out" || true
  [ "$head" = "$sha" ] || die 5 "#$pr head moved to $head while waiting for checks on $sha"
  [ "$base" = "$default_branch" ] || die 4 "#$pr base changed to '$base' while waiting"

  rc=0
  checks="$(gh pr checks "$pr" -R "$nwo" --json name,bucket,state 2>"$scratch/checks.err")" || rc=$?
  if [ "$rc" -ne 0 ] && grep -q 'no checks reported' "$scratch/checks.err"; then
    checks='[]'
  elif grep -qiE 'Resource not accessible|HTTP 403' "$scratch/checks.err"; then
    die 9 "cannot read the checks of #$pr: $(head -n1 "$scratch/checks.err")"
  elif [ "$rc" -ne 0 ] && [ "$rc" -ne 8 ]; then
    # 8 is gh's "checks pending" status; the JSON on stdout is still valid.
    die 1 "gh pr checks #$pr failed ($rc): $(head -n1 "$scratch/checks.err")"
  fi
  counts="$(jq -er 'if type != "array" then error("not an array") else
      [length,
       (map(select(.bucket == "fail" or .bucket == "cancel")) | length),
       (map(select(.bucket != "pass" and .bucket != "skipping"
                   and .bucket != "fail" and .bucket != "cancel")) | length)]
      | @tsv end' <<<"$checks")" || die 1 "unexpected gh pr checks output for #$pr"
  read -r total failed pending <<<"$counts"

  now=$(date -u +%s)
  elapsed=$((now - started))
  if [ "$failed" -gt 0 ]; then
    die 6 "#$pr has $failed failed or cancelled check(s)"
  elif [ "$total" -eq 0 ]; then
    complete_streak=0
    [ "$elapsed" -lt "$grace_s" ] || die 7 "#$pr has no checks after ${elapsed}s"
  elif [ "$pending" -eq 0 ]; then
    complete_streak=$((complete_streak + 1))
    [ "$complete_streak" -lt 2 ] || break
  else
    complete_streak=0
  fi
  [ "$elapsed" -lt "$timeout_s" ] || die 8 "timed out after ${elapsed}s waiting for the checks of #$pr"
  sleep "$interval_s"
done

# --- merge -------------------------------------------------------------------
# A human may have opened a thread or requested changes while the checks ran.
check_threads
gh pr merge "$pr" -R "$nwo" --admin --merge --match-head-commit "$sha" \
  || die 10 "gh pr merge --admin failed for #$pr at $sha"
echo "$me: merged #$pr at $sha" >&2
